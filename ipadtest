  el.querySelectorAll('[data-rel]').forEach(b=>b.onclick=()=>{const r=R.find(x=>x.k===b.dataset.rel);if(!r||G.budget<r.cost)return;G.budget-=r.cost;G.acted.release=true;const odds=releaseOdds();
    if(Math.random()*100<odds){G.released.push(r.k);if(r.k.startsWith('back_')){const k=r.k.slice(5);G.pops[k].lost=false;G.pops[k].v=50;G.pops[k].thrive=false}
      G.goodwill=Math.min(100,G.goodwill+8);news('Release',`${r.name} are released and settle in. People come from across the county to see them.`);banner('Species returned',`${r.name} are home.`);
      if(r.flag&&!G.keys.reintro){G.keys.reintro=true;news('Key achieved: Reintroduction',`${r.name} are back in Ashcombe Valley.`)}checkComplete()}
    else{news('Release',`The ${r.name.toLowerCase()} release doesn’t take: the animals don’t settle. You can try again next season.`);banner('Not this time',`${r.name} didn’t establish. Try again next season.`)}
    hud();drawOverlay()})}

// ================= economy: capacity, trust, deals, overheads, grants =================
const WORK_W=p=>{const k=HAB[p.hab].kind;if(p.hab==='newwood')return .6;if(k==='Woodland')return 1;if(p.hab==='scrub')return .8;if(['chalk','neutral','meadow','woodpasture'].includes(p.hab))return .4;if(p.hab==='riverbank')return .7;if(p.hab==='marsh')return .5;if(p.hab==='shingle')return .3;if(k==='Farmland')return .25;return .5};
const STAFF={asst:{name:'Assistant ranger',wage:180,cap:6,max:3,note:'Leads work parties and recruits. +6 ha of capacity.'},crew:{name:'Contract crew',wage:350,cap:14,max:3,note:'Seasonal team for heavy work. +14 ha of capacity.'}};
const volPool=()=>Math.round(10+.15*managed().reduce((a,p)=>a+p.area,0)+6*Object.keys(G.friends).length+(G.path==='ranger'?4:0)+(G.staff.asst||0)*3);
const recruit=n=>{const room=Math.max(0,volPool()-G.vols),g=Math.min(n,room);G.vols+=g;return g};
const capacity=()=>G.vols*.5+Object.entries(G.staff).reduce((a,[k,n])=>a+STAFF[k].cap*n,0);
const parcelLoad=p=>p.area*WORK_W(p)+(p.project?.5+.3*p.area:0);
const workload=()=>managed().reduce((a,p)=>a+parcelLoad(p),0);
const trust=()=>G.wins+managed().reduce((a,p)=>a+(p.cond==='Good'?p.area*.5:p.cond==='Moderate'&&!HAB[p.hab].nocond?p.area*.25:0),0);
const trustWord=t=>t<2?'Unknown':t<5?'Getting known':t<10?'Trusted':'Respected';
const DEAL_NAME={own:'Owned',mgmt:'Management agreement',bank:'Habitat bank partnership'};
const bankFee=()=>G.path==='nro'?25:20;
const ownUnits=()=>managed().filter(p=>p.deal==='own').reduce((a,p)=>a+unitsOf(p),0);
function overheads(){const tools=G.tools.reduce((a,k)=>a+TOOLS[k].cost,0),wages=Object.entries(G.staff).reduce((a,[k,n])=>a+STAFF[k].wage*n,0),land=managed().reduce((a,p)=>a+p.area,0);
  return{office:15,insurance:G.vols*2,tools:Math.round(tools*.03),wages,vehicle:land>20?60:0,materials:Math.round(managed().reduce((a,p)=>a+p.area*(p.fenced?5:3),0))}}
function incomeNow(){let stew=0,fees=0,mon=0;for(const p of managed()){if(p.deal==='own'&&isSemi(p))stew+=p.area*(HAB[p.hab].nocond?8:p.cond==='Good'?30:p.cond==='Moderate'?15:0);if(p.deal==='bank')fees+=p.area*bankFee()}
  if(G.path==='ecologist')mon=PARCELS.filter(p=>p.deal==='bank').reduce((a,p)=>a+p.area*5,0);return{stew:Math.round(stew),fees:Math.round(fees),mon:Math.round(mon),subs:G.path==='ranger'?Object.keys(G.friends).length*30:0}}
function volunteerSeason(){const cap=capacity(),load=workload(),r=cap>0?load/cap:9,friends=Object.keys(G.friends).length,idle=G.turn-G.engaged>=3;
  let rate=.03+(r>1?.08:0)+(G.goodwill<40?.04:0)+(idle?.04:0)-(has('urn')?.01:0)-Math.min(.03,.01*friends)-(G.path==='ranger'?.01:0)-(G.path==='ecologist'?.005:0);rate=Math.max(.01,rate);
  let lost=0;for(let i=0;i<G.vols;i++)if(Math.random()<rate)lost++;lost=Math.min(lost,Math.max(0,G.vols-2));G.vols-=lost;
  let gained=0;const pj=G.path==='ranger'?.6:G.path==='nro'?.25:.4;if(G.goodwill>=55&&Math.random()<pj)gained+=recruit(1);if((G.staff.asst||0)&&Math.random()<.5)gained+=recruit(1);
  if(lost)news('Volunteers',`${lost} volunteer${lost===1?'':'s'} stepped back this season${r>1?': people are stretched too thin':idle?': not enough going on to keep them coming':''}.${gained?` ${gained} new face${gained===1?'':'s'} joined.`:''}`);
  else if(gained)news('Volunteers','A new volunteer joins the regulars.');
  return r}
function overstretch(r){if(r<=1)return;G.goodwill=Math.max(0,G.goodwill-2);let slipped=0;
  for(const p of managed()){if(p.project&&Math.random()>1/r)p.project.stall=true;if(!p.project&&!HAB[p.hab].nocond&&p.cond!=='Poor'&&Math.random()<Math.min(.3,.1*(r-1))){p.cond=CONDS[CONDS.indexOf(p.cond)-1];slipped++}}
  news('Spread too thin',`Your workload is ${Math.round(r*100)}% of what your team can cover. Some work stalled${slipped?` and ${slipped} parcel${slipped===1?'':'s'} slipped back`:''}. Landowners are starting to notice.`);
  banner('Spread too thin','Recruit volunteers, hire staff or take on less land.')}

// grants
const GRANTS=[
  {k:'parish',name:'Parish Nature Fund',amt:300,odds:.6,minT:0,secs:6,wait:1,kind:'improve',goal:1,desc:'Bring 1 more hectare of land you manage up to Moderate or better.'},
  {k:'people',name:'Community Green Spaces Grant',amt:600,odds:.5,minT:2,secs:8,wait:2,kind:'vols',goal:12,desc:'Grow your team to 12 regular volunteers.'},
  {k:'hedge',name:'Hedgerow Recovery Fund',amt:900,odds:.5,minT:3,secs:8,wait:2,kind:'hedges',goal:2,desc:'Gap up and lay hedges round 2 fields.'},
  {k:'create',name:'Woodland and Meadow Creation Grant',amt:1800,odds:.45,minT:5,secs:8,wait:2,kind:'create',goal:5,desc:'Create 5 ha of new habitat.'},
  {k:'species',name:'Species Recovery Grant',amt:1500,odds:.45,minT:5,secs:8,wait:2,kind:'pops',goal:1,desc:'Bring one more at-risk population up to Holding on (60%) or better.'},
  {k:'county',name:'County Nature Recovery Fund',amt:2500,odds:.45,minT:7,secs:8,wait:3,kind:'improve',goal:8,desc:'Bring 8 more hectares you manage up to Moderate or better.'},
  {k:'landscape',name:'Landscape Recovery Grant',amt:7000,odds:.35,minT:10,secs:12,wait:3,kind:'connect',goal:15,desc:'Raise the valley’s connectivity by 15 points.'},
];
function metric(kind){if(kind==='improve')return managed().filter(p=>functional(p)).reduce((a,p)=>a+p.area,0);if(kind==='vols')return G.vols;if(kind==='hedges')return G.hedgesLaid;if(kind==='create')return G.createdHa;
  if(kind==='pops')return Object.values(G.pops).filter(s=>!s.lost&&s.v>=60).length;if(kind==='connect'){const N=networks();return N.total?N.main.area/N.total*100:0}return 0}
const grantOdds=g=>Math.min(.9,g.odds+(PATHS[G.path].mult.grant-1)*.25+trust()*.015);
const progressOf=a=>{const g=GRANTS.find(x=>x.k===a.k);return a.kind==='vols'?G.vols:metric(g.kind)-a.base};
function grantSeason(){const gone=[];
  for(const a of G.grants){a.left--;const g=GRANTS.find(x=>x.k===a.k);
    if(a.state==='pending'){if(a.left<=0){if(Math.random()<a.odds){a.state='active';a.left=g.secs;a.base=g.kind==='vols'?0:metric(g.kind);const up=Math.round(g.amt*.7/10)*10;G.budget+=up;a.paid=up;news('Grant awarded',`${g.name}: ${money(up)} now, the rest when you deliver. Target: ${g.desc.toLowerCase()} Deadline ${g.secs} seasons.`);banner('Grant awarded',`${g.name}: ${money(up)} up front.`)}
        else{gone.push(a);G.cool[a.k]=G.turn+2;news('Grant declined',`Your application to the ${g.name} wasn’t successful this round. You can reapply in two seasons.`)}}continue}
    if(progressOf(a)>=g.goal){const rest=g.amt-a.paid;G.budget+=rest;G.wins+=1;gone.push(a);G.cool[a.k]=G.turn+4;news('Grant delivered',`You met the ${g.name} target. The final ${money(rest)} is paid and funders take note of your track record.`);banner('Grant delivered',`${g.name}: final ${money(rest)} paid.`)}
    else if(a.left<=0){const claw=Math.round(g.amt*.3/10)*10;G.budget-=claw;G.goodwill=Math.max(0,G.goodwill-3);gone.push(a);G.cool[a.k]=G.turn+6;news('Grant target missed',`You missed the ${g.name} target. The funder claws back ${money(claw)}.`);banner('Target missed',`${money(claw)} paid back to the ${g.name}.`)}}
  G.grants=G.grants.filter(a=>!gone.includes(a))}
function renderFunding(){const el=document.getElementById('fundcard');if(!el)return;const t=trust(),inc=incomeNow(),oh=overheads(),out=Object.values(oh).reduce((a,b)=>a+b,0),inn=inc.stew+inc.fees+inc.mon+inc.subs;
  const act=G.grants.map(a=>{const g=GRANTS.find(x=>x.k===a.k);return a.state==='pending'?`<li><div><b>${g.name}</b><span>Application in. Decision ${a.left<=1?'next season':'in '+a.left+' seasons'}.</span></div><em>${money(g.amt)}</em></li>`:
    `<li><div><b>${g.name}</b><span>${g.desc} Progress: ${g.kind==='connect'?Math.round(progressOf(a))+' points':g.kind==='vols'?G.vols+' volunteers':g.kind==='pops'||g.kind==='hedges'?progressOf(a):ha(Math.max(0,progressOf(a)))+' ha'} of ${g.goal}${g.kind==='improve'||g.kind==='create'?' ha':''}. ${a.left} season${a.left===1?'':'s'} left.</span></div><em>${money(g.amt-a.paid)} due</em></li>`}).join('');
  const avail=GRANTS.filter(g=>!G.grants.some(a=>a.k===g.k)).map(g=>{const cd=(G.cool[g.k]||0)>G.turn,lock=t<g.minT;
    return `<li><div><b>${g.name} · ${money(g.amt)}</b><span>${g.desc} ${g.wait>1?`Decision takes ${g.wait} seasons. `:''}${g.secs} seasons to deliver. ${lock?`Needs a track record of ${g.minT}.`:cd?`Reapply in ${G.cool[g.k]-G.turn} season${G.cool[g.k]-G.turn===1?'':'s'}.`:`About ${Math.round(grantOdds(g)*100)}% chance.`}</span></div>${lock||cd?'<em class="no">Not yet</em>':`<button class="btn" type="button" data-grant="${g.k}" ${G.acted.apply?'disabled':''}>Apply</button>`}</li>`}).join('');
  el.innerHTML=`<h3>Track record</h3><p><b>${trustWord(t)}</b> · ${t.toFixed(1)}. It grows with every target met, project finished and hectare in good condition. Landowners and funders trust you more as it grows.</p>
    <h3>Each season</h3><dl class="stats"><dt>Coming in</dt><dd>${money(inn)}</dd><dt>Going out</dt><dd>${money(out)}</dd></dl>
    <p class="note-s">In: stewardship on land you own ${money(inc.stew)}, habitat bank fees ${money(inc.fees)}${inc.mon?`, monitoring ${money(inc.mon)}`:''}${inc.subs?`, Friends subscriptions ${money(inc.subs)}`:''}. Out: office ${money(oh.office)}, insurance ${money(oh.insurance)}, tool upkeep ${money(oh.tools)}, materials ${money(oh.materials)}${oh.vehicle?`, vehicle ${money(oh.vehicle)}`:''}${oh.wages?`, wages ${money(oh.wages)}`:''}.</p>
    ${act?`<h3>Your grants</h3><ul class="kit rel">${act}</ul>`:''}
    <h3>Apply for funding</h3><p class="note-s">One application a season. Most of the money comes up front; the rest when you hit the target. Miss it and some is clawed back.</p><ul class="kit rel">${avail}</ul>`;
  el.querySelectorAll('[data-grant]').forEach(b=>b.onclick=()=>{const g=GRANTS.find(x=>x.k===b.dataset.grant);G.acted.apply=true;G.grants.push({k:g.k,state:'pending',left:g.wait||1,odds:grantOdds(g),paid:0});news('Application sent',`You apply to the ${g.name} for ${money(g.amt)}.`);hud()})}
function renderTeam(){const el=document.getElementById('teamcard');if(!el)return;const cap=capacity(),load=workload();
  el.innerHTML=`<h3>Your team</h3><p>${G.vols} regular volunteers give you about ${ha(G.vols*.5)} ha of capacity. Workload now: <b style="color:${load>cap?'var(--poor)':'inherit'}">${ha(load)} of ${ha(cap)} ha</b>.</p>
    <p class="note-s">Woodland takes the most looking after, grazed grassland the least, and every project adds more. Go over capacity and work stalls, land slips back and volunteers burn out.</p>
    <ul class="kit">${Object.entries(STAFF).map(([k,st])=>`<li><div><b>${st.name}${G.staff[k]?` × ${G.staff[k]}`:''}</b><span>${st.note} ${money(st.wage)} a season.</span></div><div style="display:flex;gap:6px">${G.staff[k]?`<button class="btn" type="button" data-fire="${k}">Let go</button>`:''}${(G.staff[k]||0)<st.max?`<button class="btn" type="button" data-hire="${k}" ${G.budget<st.wage?'disabled':''}>Hire</button>`:''}</div></li>`).join('')}</ul>`;
  el.querySelectorAll('[data-hire]').forEach(b=>b.onclick=()=>{const k=b.dataset.hire;G.staff[k]=(G.staff[k]||0)+1;news('New staff',`You take on a ${STAFF[k].name.toLowerCase()} for ${money(STAFF[k].wage)} a season.`);hud()});
  el.querySelectorAll('[data-fire]').forEach(b=>b.onclick=()=>{const k=b.dataset.fire;G.staff[k]--;G.goodwill=Math.max(0,G.goodwill-1);news('Staff',`You let a ${STAFF[k].name.toLowerCase()} go.`);hud()})}

// ================= rivals =================
const PACE={slow:{name:'Slow',hw:.17,tb:.05,max:1,left:6,sale:[3],note:'Developers and foresters move slowly. Plenty of time to respond.'},
  steady:{name:'Steady',hw:.3,tb:.1,max:2,left:4,sale:[3,7],note:'A real contest for land. Expect to lose some battles.'},
  fast:{name:'Fast',hw:.45,tb:.15,max:3,left:3,sale:[2,5,8],note:'A housing boom. Every season counts.'}};
const RIVAL_ICON={housing:'<path d="M-6 6V-1L0 -6L6 -1V6Z M-2 6V2H2V6"/>',timber:'<path d="M0 -7L-5 1H-2L-6 6H6L2 1H5Z"/>',sale:'<path d="M3 -5Q-1 -7 -2 -3V5M-5 0H2M-5 5H5"/>'};
const isFarm=p=>['crop','grass'].includes(p.hab);
const claimOn=id=>G.claims.find(c=>c.p===id);
const housingTarget=()=>15+5*G.year;
const builtHa=()=>PARCELS.filter(p=>p.owner==='Hartwell Homes'&&(p.hab==='dev'||p.built)).reduce((a,p)=>a+p.area,0);
function pickHousing(){const c=PARCELS.filter(p=>isFarm(p)&&!p.managed&&!claimOn(p.id)&&!p.refused&&!G.partners[p.owner]&&[...p.nb].some(id=>{const q=PARCELS[id];return q.cat==='village'||q.cat==='dev'}));
  if(!c.length)return null;c.sort((a,b)=>((b.owner==='Hartwell Homes')-(a.owner==='Hartwell Homes'))||Math.hypot(a.cx-400,a.cy-470)-Math.hypot(b.cx-400,b.cy-470));return c[Math.floor(Math.random()*Math.min(4,c.length))]}
function pickTimber(){const c=PARCELS.filter(p=>isFarm(p)&&!p.managed&&!claimOn(p.id)&&!p.refused&&[...p.nb].some(id=>PARCELS[id].owner==='Northdown Timber Ltd'));return c.length?c[Math.floor(Math.random()*c.length)]:null}
function pickLot(){const est=PARCELS.filter(p=>p.owner==='Ashcombe Estate'&&!p.managed&&!claimOn(p.id)&&p.cat!=='copse');if(!est.length)return null;
  const seed=est[Math.floor(Math.random()*est.length)],lot=[seed],seen=new Set([seed.id]);let area=seed.area;
