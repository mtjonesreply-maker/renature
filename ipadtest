    for (let dr = -1; dr <= 1; dr++) for (let dc = -1; dc <= 1; dc++){ if (!dr && !dc) continue; const vc = uc + dc, vr = ur + dr; if (vc < 0 || vr < 0 || vc >= GW || vr >= GH) continue; const v = vr * GW + vc; if (closed[v] || COST[v] === Infinity) continue;
      if (dr && dc && (COST[ur * GW + vc] === Infinity || COST[vr * GW + uc] === Infinity)) continue;
