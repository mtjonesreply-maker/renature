function popSeason(N){for(const k in G.pops){const s=G.pops[k];if(s.lost)continue;const p=PARCELS[s.p],c=N.comp.get(p.id);
    let d=functional(p)?-2:-3;if(p.managed)d+=p.cond==='Good'?5:p.cond==='Moderate'?3:1;if(c){if(c.area>=100)d+=6;else if(c.area>=40)d+=3}
