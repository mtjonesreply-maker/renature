      ${key(G.keys.sustain,'Sustainability',`<p>${Math.round(cover*100)}% of the valley is healthy habitat or habitat you are restoring. Hold ${GOALS.sustain*100}% for ${GOALS.hold/4} years.</p>${bar(cover,GOALS.sustain)}${!G.keys.sustain&&G.hold?`<p class="note-s">Held for ${G.hold} of ${GOALS.hold} seasons</p>`:''}`)}
      ${key(G.keys.reintro,'Reintroduction',`<p>Bring back a flagship species: white storks or beavers.</p><p class="note-s">Release success now ${releaseOdds()}%. The longer the valley waits, the harder it gets, but it never drops below 50%.</p>`)}
    </ul>
    <h3>Species at risk</h3><ul class="owners">${pops}</ul>
