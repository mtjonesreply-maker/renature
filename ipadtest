<style>
/* Layout: strategy-game campaign screen — resource bar across the top, the valley map as the stage, a site dossier panel on the right (below on phones). Deliberately a single dark look: it is a game screen, not a document. */
.touch{display:none}@media (pointer:coarse){.touch{display:revert}.mouse{display:none!important}}
button{touch-action:manipulation}
.mapbox{-webkit-touch-callout:none;-webkit-user-select:none;user-select:none;-webkit-tap-highlight-color:transparent}
:root{
  color-scheme:dark;
  --bg:#0E1511; --panel:#16201A; --panel-2:#1D2a22; --line:#2B3B30; --ink:#E6ECE2; --muted:#93A496;
  --hivis:#D3E63A; --hivis-ink:#1C2408; --gold:#E3B54A; --good:#6CC488; --mid:#E2AE45; --poor:#EE7F73; --water:#7FB0C6;
  --display:"Zilla Slab",Georgia,serif; --body:"Source Sans 3","Segoe UI",system-ui,sans-serif; --mono:"IBM Plex Mono",ui-monospace,monospace;
}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body);font-size:15px;line-height:1.45;padding-inline:16px;padding-block:14px}
.wrap{max-width:1720px;margin:0 auto;display:flex;flex-direction:column;gap:12px}

.hud{display:flex;flex-wrap:wrap;align-items:center;gap:8px 18px;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:10px 16px}
.brand{display:flex;flex-direction:column;margin-right:auto}
.brand small{font-size:.7rem;letter-spacing:.16em;text-transform:uppercase;color:var(--muted);font-weight:700}
.brand b{font-family:var(--display);font-size:1.5rem;line-height:1.05}
.res{display:flex;flex-direction:column;min-width:0}
.res small{font-size:.68rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:700}
.res span{font-family:var(--mono);font-size:1.1rem;font-variant-numeric:tabular-nums}
.season{font-family:var(--display);font-size:1.1rem}
.endturn{position:absolute;right:12px;bottom:12px;font:inherit;font-size:1.05rem;font-weight:800;padding:12px 20px;border-radius:12px;box-shadow:0 6px 18px rgba(0,0,0,.4);border:none;background:var(--hivis);color:var(--hivis-ink);cursor:pointer}
.endturn:hover{filter:brightness(1.08)}
button:focus-visible,a:focus-visible{outline:3px solid var(--hivis);outline-offset:2px}

.main{display:grid;grid-template-columns:minmax(0,1fr) 340px;gap:12px;align-items:start}
@media (min-width:981px){.main{grid-template-columns:auto minmax(300px,420px);justify-content:center}.main .mapbox{width:var(--mapw,800px);max-width:none}}
@media (max-width:980px){.main{grid-template-columns:minmax(0,1fr)}}

.mapbox{position:relative;width:100%;aspect-ratio:1200/750;max-width:100%;overflow:hidden;border-radius:14px;border:1px solid var(--line);background:#2c4a5c;touch-action:none;cursor:grab}
.mapbox.dragging{cursor:grabbing}
.world{position:absolute;inset:0;transform-origin:0 0;transition:transform .6s cubic-bezier(.3,.7,.2,1)}
.world.nofx{transition:none}
.world canvas,.world svg{position:absolute;inset:0;width:100%;height:100%;display:block}
#fog{pointer-events:none}

.loading{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--display);font-size:1.2rem;color:var(--muted);background:var(--panel)}
.terr{cursor:pointer}
.ls{transform:scale(var(--ls,1));transform-origin:0 0;transition:transform .6s cubic-bezier(.3,.7,.2,1)}
.world.nofx .ls{transition:none}
.terr:hover .tfill{fill-opacity:.22}
.press{cursor:pointer}
.press:hover circle{stroke-width:3}
.zoombar{position:absolute;left:12px;bottom:12px;display:flex;gap:6px}
.zoombar button{font:inherit;font-weight:700;min-width:38px;height:38px;padding:0 12px;border-radius:10px;border:1px solid rgba(255,255,255,.25);background:rgba(14,21,17,.82);color:#EEF2EA;cursor:pointer}
.scalebar{position:absolute;left:12px;top:12px;display:flex;align-items:center;gap:8px;background:rgba(14,21,17,.72);padding:6px 10px;border-radius:8px;pointer-events:none}
.scalebar i{display:block;height:6px;border:1.5px solid #E6ECE2;border-top:none;background:linear-gradient(90deg,#E6ECE2 50%,transparent 50%)}
.scalebar span{font-family:var(--mono);font-size:.75rem;color:#E6ECE2}
.compass{position:absolute;right:12px;top:12px;width:46px;height:46px;pointer-events:none}
.compass svg{width:100%;height:100%;display:block}
.hint{position:absolute;right:12px;bottom:66px;font-size:.78rem;color:#E6ECE2;background:rgba(14,21,17,.7);padding:4px 10px;border-radius:8px;pointer-events:none}
.banner{position:absolute;left:50%;top:14px;transform:translate(-50%,-8px);opacity:0;max-width:min(92%,560px);background:rgba(14,21,17,.92);border:1px solid var(--gold);color:var(--ink);padding:10px 16px;border-radius:12px;transition:opacity .3s,transform .3s;pointer-events:none}
.banner.show{opacity:1;transform:translate(-50%,0)}
.banner b{display:block;font-family:var(--display);color:var(--gold);font-size:1.05rem}

.side{display:flex;flex-direction:column;gap:12px;min-width:0}
.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:16px;display:flex;flex-direction:column;gap:10px;min-width:0}
.card h2{font-family:var(--display);font-size:1.45rem;line-height:1.1;margin:0;text-wrap:balance}
.card h3{font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:4px 0 0}
.card p{margin:0}
.chip{align-self:flex-start;font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:3px 9px;border-radius:999px}
.chip.own{background:var(--hivis);color:var(--hivis-ink)}
.chip.avail{background:transparent;border:1px dashed #fff;color:#fff}
.chip.locked{background:var(--panel-2);color:var(--muted);border:1px solid var(--line)}
.chip.threat{background:#4A2420;color:#FFC9C2}
.stats{display:grid;grid-template-columns:auto 1fr;gap:4px 14px;margin:0;font-size:.92rem}
.stats dt{color:var(--muted)}
.stats dd{margin:0;font-weight:600}
.cond{font-weight:700}
.cond.Good{color:var(--good)}.cond.Moderate{color:var(--mid)}.cond.Poor{color:var(--poor)}
.threats{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px}
.threats li{display:flex;gap:8px;align-items:flex-start;font-size:.92rem}
.threats li i{flex:none;width:8px;height:8px;border-radius:50%;margin-top:7px;background:var(--poor)}
.goal{padding:10px 12px;border-left:3px solid var(--gold);background:var(--panel-2);border-radius:0 10px 10px 0;font-size:.93rem}
.actions{display:flex;flex-wrap:wrap;gap:8px}
.btn{font:inherit;font-weight:700;font-size:.93rem;padding:9px 14px;border-radius:10px;border:1px solid var(--line);background:var(--panel-2);color:var(--ink);cursor:pointer;text-decoration:none;display:inline-flex;align-items:center}
.btn.primary{background:var(--hivis);color:var(--hivis-ink);border-color:var(--hivis)}
.btn:disabled{opacity:.45;cursor:default}
.feed{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px;max-height:220px;overflow-y:auto}
.feed li{font-size:.9rem;padding-bottom:8px;border-bottom:1px solid var(--line)}
.feed li b{display:block;font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--gold)}
.title{position:fixed;inset:0;z-index:70;display:grid;place-items:center;overflow:hidden;background:#0F1612}
.tbg{position:absolute;inset:0;width:100%;height:100%}
.tinner{position:relative;text-align:center;display:flex;flex-direction:column;align-items:center;gap:14px;padding:16px;margin-top:-6vh}
.tkick{margin:0;font-size:.8rem;letter-spacing:.3em;text-transform:uppercase;color:#E8D9A8;font-weight:700}
.title h1{margin:0;font-family:var(--display);font-weight:700;font-size:clamp(3.6rem,13vw,9rem);line-height:.9;letter-spacing:-.01em;color:#F4F1E4;text-shadow:0 4px 30px rgba(0,0,0,.35)}
.tstrap{margin:0;font-size:clamp(1.05rem,2.4vw,1.45rem);color:#EDE6CF;max-width:30ch}
.tgo{margin-top:18px;font:inherit;font-size:1.15rem;font-weight:800;padding:14px 38px;border-radius:999px;border:none;background:var(--hivis);color:var(--hivis-ink);cursor:pointer;box-shadow:0 10px 30px rgba(0,0,0,.35)}
.tgo:hover{filter:brightness(1.08)}
.wdparty{display:flex;flex-direction:column;gap:6px;width:100%}.wdparty .wdlab{font-weight:700}.wdrow{display:flex;gap:8px;align-items:center;flex-wrap:wrap}.wdrow .sz{min-width:40px;padding-left:0;padding-right:0;justify-content:center}.wdrow .wdn{font-family:var(--mono);font-size:1.2rem;min-width:2ch;text-align:center}
.tgo.second{background:rgba(14,21,17,.7);color:#EDE6CF;border:1px solid rgba(237,230,207,.4);box-shadow:none;font-size:1rem;padding:11px 28px;margin-top:0}
.tsave{margin:-6px 0 0;color:#D9D2BA;font-size:.95rem}
.tlink{font:inherit;background:none;border:none;color:#D9D2BA;text-decoration:underline;cursor:pointer;font-size:.95rem;padding:6px}
.devbar{position:fixed;right:14px;bottom:14px;z-index:35;width:270px;max-height:calc(100vh - 120px);overflow:auto;background:var(--panel);border:2px dashed var(--hivis);border-radius:12px;padding:10px 12px;box-shadow:0 12px 32px rgba(0,0,0,.45);font-size:.88rem}
.devbar[hidden]{display:none}
.devbar h3{margin:0 0 4px;font-size:.8rem;letter-spacing:.14em;text-transform:uppercase;color:var(--hivis)}
.devbar p{margin:0 0 8px;color:var(--muted);font-size:.8rem}
.devbar .dl{display:grid;grid-template-columns:1fr 1fr;gap:4px;margin:6px 0}
.devbar .dl button{font:inherit;font-size:.8rem;text-align:left;padding:6px 8px;border-radius:7px;border:1px solid var(--line);background:var(--panel-2);color:var(--ink);cursor:pointer}
.devbar .dl button:hover{border-color:var(--hivis)}
.devbar .row{display:flex;gap:6px;align-items:center;flex-wrap:wrap;margin:4px 0}
.devbar select{font:inherit;font-size:.82rem;background:var(--panel-2);color:var(--ink);border:1px solid var(--line);border-radius:7px;padding:4px 6px}
.devbar .min{float:right;font:inherit;background:none;border:none;color:var(--muted);cursor:pointer;font-size:.8rem}
.devbar.small .body{display:none}
.devbar.small{width:auto}.devbar.small h3{margin:0 70px 0 0}
.menupop .saved{display:block;padding:8px 12px 2px;font-size:.8rem;color:var(--muted)}
@media (prefers-reduced-motion:no-preference){.tinner{animation:tin .9s cubic-bezier(.2,.7,.2,1) both}@keyframes tin{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}}
.select{max-width:1240px;margin:0 auto;display:flex;flex-direction:column;gap:22px;padding-block:18px 10px}
.select header{display:flex;flex-direction:column;gap:8px;max-width:70ch}
.select .eyebrow{font-size:.74rem;letter-spacing:.18em;text-transform:uppercase;color:var(--muted);font-weight:700;margin:0}
.select h1{font-family:var(--display);font-weight:700;font-size:clamp(2.2rem,5vw,3.4rem);line-height:1;margin:0;text-wrap:balance}
.select header p{margin:0;color:#C9D3C6;font-size:1.05rem}
.pcards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
@media (max-width:920px){.pcards{grid-template-columns:minmax(0,1fr)}}
.pcard{position:relative;background:var(--panel);border:1px solid var(--line);border-top:5px solid var(--pc);border-radius:16px;padding:20px;display:flex;flex-direction:column;gap:14px;min-width:0}
.pcard .top{display:flex;gap:14px;align-items:center}
.pcard .emblem{flex:none;width:64px;height:64px;border-radius:16px;background:var(--panel-2);display:grid;place-items:center;border:1px solid var(--line)}
.pcard .emblem svg{width:44px;height:44px;fill:none;stroke:var(--pc);stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.pcard h2{font-family:var(--display);font-size:1.55rem;line-height:1.05;margin:0}
.pcard .scale{display:inline-block;margin-top:4px;font-size:.7rem;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--pc)}
.pcard .tag{margin:0;font-style:italic;color:#C9D3C6}
.pcard h3{font-size:.7rem;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin:0 0 4px}
.pcard ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:4px}
.pcard li{display:flex;gap:8px;font-size:.95rem}
.pcard li b{flex:none;width:16px;text-align:center;font-family:var(--mono)}
.pcard li.plus b{color:var(--good)} .pcard li.minus b{color:var(--poor)}
.pcard .sig{padding:10px 12px;border-radius:10px;background:var(--panel-2);border-left:3px solid var(--pc);font-size:.92rem}
.pcard .sig b{display:block;font-family:var(--display);font-size:1.02rem;margin-bottom:2px}
.pcard .startres{display:flex;flex-wrap:wrap;gap:6px 14px;font-family:var(--mono);font-size:.85rem;color:#C9D3C6;margin-top:auto}
.pcard .startres span{white-space:nowrap}
.choose{font:inherit;font-weight:700;padding:11px 16px;border-radius:10px;border:none;background:var(--pc);color:#11180F;cursor:pointer}
.choose:hover{filter:brightness(1.08)}
.pathchip{display:inline-flex;align-items:center;gap:6px;font-size:.72rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--pc)}
.pathchip i{width:8px;height:8px;border-radius:50%;background:var(--pc)}
.lens{padding:10px 12px;border-radius:10px;background:var(--panel-2);border-left:3px solid var(--pc);font-size:.92rem}
.lens b{display:block;font-size:.7rem;letter-spacing:.12em;text-transform:uppercase;color:var(--pc);margin-bottom:2px}
.secret{padding:10px 12px;border-radius:10px;border:1px dashed var(--pc);font-size:.92rem}
.chip.feat{background:var(--panel-2);color:#D7E0D3;border:1px solid var(--line)}
.chip.fog{background:transparent;color:var(--muted);border:1px dashed var(--line)}
.zoombar .on{background:var(--gold);color:#1C1606;border-color:var(--gold)}
.menu{position:relative}
.menubtn{font:inherit;width:42px;height:42px;border-radius:10px;border:1px solid var(--line);background:var(--panel-2);color:var(--ink);cursor:pointer;display:grid;place-items:center}
.menubtn svg{width:20px;height:20px}
.menupop{position:absolute;top:calc(100% + 8px);left:0;z-index:40;min-width:250px;background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:6px;box-shadow:0 12px 32px rgba(0,0,0,.45);display:flex;flex-direction:column}
.menupop button{font:inherit;text-align:left;padding:10px 12px;border-radius:8px;border:none;background:none;color:var(--ink);cursor:pointer}
.menupop button:hover{background:var(--panel-2)}
.menupop small{display:block;color:var(--muted);font-size:.8rem}
.menupop .confirm{padding:10px 12px;display:flex;flex-direction:column;gap:8px;font-size:.9rem}
.menupop .confirm div{display:flex;gap:8px}
.menupop .confirm .btn{flex:1;justify-content:center;text-align:center}
.menupop .confirm .btn{border:1px solid var(--line);background:var(--panel-2);font-weight:700}
.menupop .confirm .btn.primary{background:var(--hivis);color:var(--hivis-ink);border-color:var(--hivis)}
.kit{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
.kit li{display:flex;align-items:center;gap:10px;justify-content:space-between;padding:8px 10px;border-radius:10px;background:var(--panel-2);font-size:.85rem}
.kit li b{display:block;font-size:.92rem}
.kit li span{color:var(--muted)}
.kit li em{font-style:normal;font-size:.75rem;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--good);flex:none}
.kit li .btn{flex:none;padding:7px 11px;font-size:.85rem}
.opt .needs{color:var(--poor)!important;font-weight:600;margin-top:3px}
.keys{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px}
.keys li{display:flex;flex-direction:column;gap:5px;font-size:.88rem}
.keys li p{margin:0}
.kh{display:flex;align-items:center;gap:8px}
.kh b{font-size:1rem}
.kdot{width:20px;height:20px;border-radius:50%;border:2px solid var(--line);display:grid;place-items:center;font-size:.75rem;font-weight:800;color:var(--hivis-ink)}
.keys li.done .kdot{background:var(--hivis);border-color:var(--hivis)}
.gbar{position:relative;height:8px;border-radius:4px;background:var(--panel-2);overflow:hidden}
.gbar i{position:absolute;inset:0 auto 0 0;background:var(--good);border-radius:4px}
.kit.rel li{align-items:flex-start}
.kit.rel li.done{border:1px solid var(--good)}
.kit em.no{color:var(--muted)}
.flag{display:inline-block;font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);border:1px solid var(--gold);border-radius:4px;padding:0 4px;margin-left:4px;vertical-align:2px}
.done{position:fixed;inset:0;z-index:60;background:rgba(6,10,8,.72);display:grid;place-items:center;padding:16px}
.donebox{max-width:520px;width:100%;background:var(--panel);border:1px solid var(--good);border-radius:16px;padding:24px;display:flex;flex-direction:column;gap:12px}
.donebox h2{font-family:var(--display);font-size:2rem;margin:0}
.donebox .eyebrow{margin:0;font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:var(--good);font-weight:700}
.donebox p{margin:0}
.pace{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:12px 20px;background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px 16px}
.pace b{display:block}.pace span{color:var(--muted);font-size:.92rem}
.seg{display:flex;border:1px solid var(--line);border-radius:10px;overflow:hidden}
.seg button{font:inherit;font-weight:700;padding:9px 16px;border:none;background:var(--panel-2);color:var(--ink);cursor:pointer}
.seg button+button{border-left:1px solid var(--line)}
.seg button.on{background:var(--gold);color:#1C1606}
.owners.play li{display:contents;cursor:pointer}
.owners.play span:hover{text-decoration:underline}
button.chip{display:inline-flex;align-items:center}
.iconbar{display:flex;gap:6px}
.ib{position:relative;font:inherit;display:flex;flex-direction:column;align-items:center;gap:2px;min-width:62px;padding:6px 8px 5px;border-radius:10px;border:1px solid var(--line);background:var(--panel-2);color:var(--ink);cursor:pointer}
.ib svg{width:22px;height:22px}
.ib span{font-size:.68rem;font-weight:700;letter-spacing:.04em;color:var(--muted)}
.ib:hover{border-color:var(--hivis)}
.ib.on{background:var(--gold);border-color:var(--gold);color:#1C1606}.ib.on span{color:#1C1606}
.badge{position:absolute;top:-6px;right:-6px;min-width:18px;height:18px;padding:0 5px;border-radius:9px;background:var(--poor);color:#1A0B09;font-size:.7rem;font-weight:800;display:grid;place-items:center}
.drawer{position:fixed;z-index:50;top:96px;right:max(16px,calc((100vw - 1720px)/2 + 16px));width:min(430px,calc(100vw - 32px));max-height:calc(100vh - 112px);display:flex;flex-direction:column;background:var(--panel);border:1px solid var(--line);border-radius:14px;box-shadow:0 18px 48px rgba(0,0,0,.5)}
.pn{display:flex;flex-direction:column;min-height:0;max-height:inherit}
.pn header{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:14px 16px 10px;border-bottom:1px solid var(--line)}
