// A 1 ha grid (1 map unit = 4 m), merged into fields, compartments and plots.
const CS=25,COLS=48,ROWS=30,M2=16/10000; // ha per unit^2
let V=[],CELLS=[],PARCELS=[],ROADS=new Set();
const vkey=(t,c,r)=>t+c+'_'+r;
function buildMosaic(){
  const r=rng(2026);
  V=[];for(let c=0;c<=COLS;c++){V[c]=[];for(let rr=0;rr<=ROWS;rr++){const edge=c===0||c===COLS||rr===0||rr===ROWS;V[c][rr]=[c*CS+(edge?0:(hash(c,rr)-.5)*13),rr*CS+(edge?0:(hash(rr+99,c)-.5)*13)]}}
  // roads run along grid lines, so they are boundaries
  for(let c=0;c<COLS;c++)ROADS.add(vkey('h',c,19));
  for(let rr=0;rr<19;rr++)ROADS.add(vkey('v',28,rr));
  for(let rr=19;rr<25;rr++)ROADS.add(vkey('v',19,rr));
  for(let c=19;c<30;c++)ROADS.add(vkey('h',c,25));
  for(let rr=10;rr<19;rr++)ROADS.add(vkey('v',12,rr));
  CELLS=[];
  for(let rr=0;rr<ROWS;rr++)for(let c=0;c<COLS;c++){
    const q=[V[c][rr],V[c+1][rr],V[c+1][rr+1],V[c][rr+1]],cx=q.reduce((a,p)=>a+p[0],0)/4,cy=q.reduce((a,p)=>a+p[1],0)/4;
    const cell={i:rr*COLS+c,c,r:rr,q,cx,cy,parcel:null,...classify(cx,cy)};
    cell.site=null;for(const k in SITE_POLYS)if(inPoly(cx,cy,SITE_POLYS[k])){cell.site=k;break}
    if(cell.site==='farm'&&(cell.cat==='farm'||cell.cat==='down'))cell.owner='Bramble Bottom Farm';
    CELLS.push(cell);
  }
  // village sub-uses
  const vil=CELLS.filter(c=>c.cat==='village');
  const near=(x,y)=>vil.slice().sort((a,b)=>Math.hypot(a.cx-x,a.cy-y)-Math.hypot(b.cx-x,b.cy-y))[0];
  const tag=(cell,t)=>{if(cell&&cell.cat==='village'&&!cell.vuse)cell.vuse=t};
  tag(near(512,452),'church');tag(near(462,505),'green');tag(near(540,505),'orchard');tag(near(445,450),'allotment');
  vil.forEach(c=>{if(!c.vuse)c.vuse='gardens'});
  // grow parcels
  const at=(c,rr)=>c>=0&&c<COLS&&rr>=0&&rr<ROWS?CELLS[rr*COLS+c]:null;
  const same=(a,b)=>a&&b&&!a.parcel&&a.cat===b.cat&&a.ent===b.ent&&a.owner===b.owner&&a.site===b.site&&(a.vuse||'')===(b.vuse||'');
  const rectOK=(c0,r0,w,h,seed)=>{for(let rr=r0;rr<r0+h;rr++)for(let c=c0;c<c0+w;c++){if(!same(at(c,rr),seed))return false}
    for(let rr=r0+1;rr<r0+h;rr++)for(let c=c0;c<c0+w;c++)if(ROADS.has(vkey('h',c,rr)))return false;
    for(let c=c0+1;c<c0+w;c++)for(let rr=r0;rr<r0+h;rr++)if(ROADS.has(vkey('v',c,rr)))return false;return true};
  const SIZES={farm:[[4,3],[3,3],[4,2],[3,2],[2,3],[2,2],[2,1],[1,2],[1,1]],down:[[3,3],[3,2],[2,2],[2,1],[1,1]],marsh:[[4,2],[3,2],[2,2],[2,1],[1,1]],shingle:[[4,1],[3,1],[2,1],[1,1]],stream:[[1,3],[1,2],[1,1]],
    wood:[[2,2],[2,1],[1,2],[1,1]],copse:[[2,1],[1,2],[1,1],[2,2]],village:[[2,1],[1,1]]};
  const newParcel=cells=>{const p={id:PARCELS.length,cells,cat:cells[0].cat,ent:cells[0].ent,owner:cells[0].owner,site:cells[0].site,vuse:cells[0].vuse,managed:false,project:null,hedge:.35+r()*.5};cells.forEach(c=>c.parcel=p);PARCELS.push(p);return p};
  // whole-entity parcels first
  ['dev','meadow'].forEach(e=>{const cs=CELLS.filter(c=>c.ent===e&&c.cat!=='sea');if(cs.length)newParcel(cs)});
  // the starting compartment: a single hectare near the heart of Hollow Copse
  const start=CELLS.filter(c=>c.ent==='copse').sort((a,b)=>Math.hypot(a.cx-628,a.cy-372)-Math.hypot(b.cx-628,b.cy-372))[0];
  const sp=newParcel([start]);sp.managed=true;sp.start=true;
  for(const cell of CELLS){if(cell.parcel||cell.cat==='sea')continue;
    const sizes=SIZES[cell.cat]||[[1,1]];const order=sizes.slice();if(cell.cat==='farm'&&r()<.4)order.unshift(order.splice(1+Math.floor(r()*3),1)[0]);
    for(const[w,h]of order){if(rectOK(cell.c,cell.r,w,h,cell)){const cs=[];for(let rr=cell.r;rr<cell.r+h;rr++)for(let c=cell.c;c<cell.c+w;c++)cs.push(at(c,rr));newParcel(cs);break}}
    if(!cell.parcel)newParcel([cell]);
  }
  // describe each parcel
  const counters={};const take=(list,key)=>{counters[key]=(counters[key]||0)+1;return list[(counters[key]-1)%list.length]};
  for(const p of PARCELS){
    p.area=p.cells.reduce((a,c)=>a+polyArea(c.q),0)*M2;
    p.cx=p.cells.reduce((a,c)=>a+c.cx,0)/p.cells.length;p.cy=p.cells.reduce((a,c)=>a+c.cy,0)/p.cells.length;
    p.angle=r()*Math.PI;
    const roll=r();
    switch(p.cat){
      case'farm':{const pasture=r()<.28;p.hab=pasture?'grass':'crop';p.crop=pasture?null:CROPS[Math.floor(r()*CROPS.length)];p.name=take(NAMES.field,'field');p.cond='Poor';break}
      case'copse':case'wood':{const e=ENT[p.ent];p.hab=p.ent==='copse'?'ancient':e.hab;
        if(p.ent==='copse')p.name=p.start?'The Hollow':take(NAMES.copse.slice(1),'copse');else p.name=`${e.name}, compartment ${(counters[p.ent]=(counters[p.ent]||0)+1)}`;
        p.cond=p.ent==='copse'?(p.start||roll<.8?'Poor':'Moderate'):p.ent==='east'?'Good':p.ent==='north1'?'Poor':(roll<.5?'Poor':'Moderate');break}
      case'down':p.hab=fbm(p.cx/90,p.cy/90,3)>.55?'scrub':'chalk';p.name=take(NAMES.down,'down');p.cond=p.hab==='scrub'?'Moderate':(roll<.6?'Poor':'Moderate');break;
      case'marsh':p.hab='marsh';p.name=take(NAMES.marsh,'marsh');p.cond=roll<.5?'Poor':'Moderate';break;
      case'shingle':p.hab='shingle';p.name=take(NAMES.shingle,'shingle');p.cond='Moderate';break;
      case'stream':p.hab='riverbank';p.name=take(NAMES.stream,'stream');p.cond=roll<.6?'Poor':'Moderate';break;
      case'meadow':p.hab='meadow';p.name='Old Rectory Meadow';p.cond='Moderate';break;
      case'dev':p.hab='dev';p.name='Ashcombe Fields (building site)';p.cond='Poor';break;
      case'village':p.hab=p.vuse;p.name=p.vuse==='church'?'St Mary’s churchyard':p.vuse==='orchard'?'Community orchard':p.vuse==='allotment'?'Ashcombe allotments':p.vuse==='green'?'Village green':take(NAMES.gardens,'gardens')+' gardens';p.cond=p.vuse==='orchard'?'Poor':'Moderate';break;
    }
    if(!p.name)p.name='Land parcel';
  }
  // neighbours
  for(const cell of CELLS){if(!cell.parcel)continue;const p=cell.parcel;p.nb=p.nb||new Set();
    [[1,0],[-1,0],[0,1],[0,-1]].forEach(([dc,dr])=>{const n=at(cell.c+dc,cell.r+dr);if(n&&n.parcel&&n.parcel!==p)p.nb.add(n.parcel.id)})}
}
function classify(x,y){
  if(y>coastY(x)-2)return{cat:'sea'};
  if(y>coastY(x)-20&&x>420)return{cat:'shingle',ent:'shingle',owner:'The Crown Estate'};
  if(inPoly(x,y,DEV))return{cat:'dev',ent:'dev',owner:'Hartwell Homes'};
  if(Math.hypot(x-VILLAGE[0],y-VILLAGE[1])<64)return{cat:'village',ent:'village',owner:'Residents'};
  if(inPoly(x,y,WOODS.copse))return{cat:'copse',ent:'copse',owner:'Hollow Copse Trust'};
  for(const k of['hanger','north1','north2','west','east'])if(inPoly(x,y,WOODS[k]))return{cat:'wood',ent:k,owner:ENT[k].owner};
  if(inPoly(x,y,MEADOW))return{cat:'meadow',ent:'meadow',owner:'Ashcombe Parish Council'};
  if(y<650&&Math.abs(x-riverX(y))<14)return{cat:'stream',ent:'stream',owner:'Riparian landowners'};
  if(x>790&&y>coastY(x)-90)return{cat:'marsh',ent:'marsh',owner:'Coombe Farm'};
  if(Math.exp(-Math.pow((y-ridgeY(x))/110,2))>0.55&&x<1000)return{cat:'down',ent:'down',owner:'Ashcombe Estate'};
  let owner='Manor Farm';if(inPoly(x,y,SITE_POLYS.farm))owner='Bramble Bottom Farm';else if(y<170)owner='Ashcombe Estate';else if(x>900)owner='Coombe Farm';else if(x>560&&x<800&&y>480)owner='Glebe Farm';
  return{cat:'farm',ent:'farm',owner};
}
