<script>
// ================= noise & geometry =================
function hash(x,y){let h=(Math.imul(x,374761393)+Math.imul(y,668265263))|0;h=Math.imul(h^(h>>>13),1274126177);return((h^(h>>>16))>>>0)/4294967296}
function vnoise(x,y){const xi=Math.floor(x),yi=Math.floor(y),xf=x-xi,yf=y-yi,u=xf*xf*(3-2*xf),v=yf*yf*(3-2*yf);
  const a=hash(xi,yi),b=hash(xi+1,yi),c=hash(xi,yi+1),d=hash(xi+1,yi+1);return a+(b-a)*u+(c-a)*v+(a-b-c+d)*u*v}
function fbm(x,y,o=5){let s=0,a=.5,fq=1;for(let i=0;i<o;i++){s+=a*vnoise(x*fq,y*fq);a*=.5;fq*=2}return s}
function rng(seed){return function(){seed|=0;seed=seed+0x6D2B79F5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
const ridgeY=x=>235+38*Math.sin(x/260)+18*Math.sin(x/97);
const coastY=x=>688+12*Math.sin(x/80)+8*Math.sin(x/37+1);
const riverX=y=>1000-y*0.33+40*Math.sin(y/70)+20*Math.sin(y/31);
const riverW=y=>2.2+y/150+(y>640?(y-640)*0.22:0);
function inPoly(x,y,P){let c=false;for(let i=0,j=P.length-1;i<P.length;j=i++){const[xi,yi]=P[i],[xj,yj]=P[j];if(((yi>y)!==(yj>y))&&(x<(xj-xi)*(y-yi)/(yj-yi)+xi))c=!c}return c}
const bbox=P=>{const xs=P.map(p=>p[0]),ys=P.map(p=>p[1]);return[Math.min(...xs),Math.min(...ys),Math.max(...xs),Math.max(...ys)]};
const polyArea=P=>{let a=0;for(let i=0,j=P.length-1;i<P.length;j=i++)a+=(P[j][0]+P[i][0])*(P[j][1]-P[i][1]);return Math.abs(a/2)};
const WOODS={
  copse:[[558,324],[642,308],[700,338],[696,406],[634,434],[566,412]],
  hanger:[[356,302],[548,292],[560,326],[515,344],[378,342]],
  north1:[[60,40],[250,28],[272,108],[150,142],[70,120]],
  north2:[[820,48],[980,38],[1002,118],[900,150],[832,130]],
  west:[[34,250],[150,236],[162,330],[60,344]],
  east:[[1000,330],[1124,318],[1144,408],[1032,432]],
};
const DEV=[[322,478],[420,466],[432,558],[338,570]];
const VILLAGE=[485,476];
const MEADOW=[[440,378],[524,372],[530,428],[446,434]];
const SITE_POLYS={copse:WOODS.copse,farm:[[688,248],[852,244],[856,462],[696,466]],brook:[[800,466],[904,456],[900,612],[796,616]],down:[[178,168],[442,158],[452,302],[190,312]],meadow:MEADOW,marsh:[[812,612],[1120,598],[1134,668],[822,682]]};

// ================= terrain =================
function drawTerrain(){
  const W=1200,H=750,hm=new Float32Array(W*H);
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){
    const r=Math.exp(-Math.pow((y-ridgeY(x))/110,2))*(x<1000?1:Math.max(0,1-(x-1000)/220));
    const dr=Math.abs(x-riverX(y));
    hm[y*W+x]=0.15+0.75*r+0.28*fbm(x/170,y/170)-0.22*Math.exp(-Math.pow(dr/70,2));
  }
  const base=document.createElement('canvas');base.width=W;base.height=H;
  const bx=base.getContext('2d'),img=bx.createImageData(W,H),d=img.data;
  for(let y=0;y<H;y++)for(let x=0;x<W;x++){
    const i=y*W+x,cy=coastY(x),n=fbm(x/38,y/38,3);let col,shade=1;
    if(y>cy){const t=Math.min(1,(y-cy)/40);col=[96-44*t,150-52*t,168-40*t];col=col.map(v=>v+(n-.5)*14)}
    else if(y>cy-7)col=[214+(n-.5)*20,206+(n-.5)*20,178];
    else{
      const h=hm[i],r=Math.exp(-Math.pow((y-ridgeY(x))/110,2))*(x<1000?1:Math.max(0,1-(x-1000)/220));
      if(x>790&&y>cy-85)col=[136,156,116];
      else if(r>0.55)col=[176,186,124];
      else col=[132,162,88];
      if(r>0.4&&r<=0.55){const k=(r-.4)/.15;col=col.map((v,j)=>v*(1-k)+[176,186,124][j]*k)}
      col=col.map((v,j)=>v+(n-.5)*(j===2?18:28));
      const xm=Math.max(1,x)-1,ym=Math.max(1,y)-1,xp=Math.min(W-2,x)+1,yp=Math.min(H-2,y)+1;
      shade=1+(hm[ym*W+xm]-hm[yp*W+xp])*34;shade=Math.max(.68,Math.min(1.32,shade));
    }
    d[i*4]=col[0]*shade;d[i*4+1]=col[1]*shade;d[i*4+2]=col[2]*shade;d[i*4+3]=255;
  }
  bx.putImageData(img,0,0);
  return base;
}


// ================= habitats =================
// dist = distinctiveness score used by the biodiversity metric (area x distinctiveness x condition)
const HAB={
  crop:{label:'Cropland',kind:'Farmland',dist:2,dname:'Low',nocond:true},
  grass:{label:'Modified grassland',kind:'Farmland',dist:2,dname:'Low',nocond:true,col:'#8FB25A',desc:'Sheep-grazed improved grassland: reseeded and fertilised, so few wild flowers survive.'},
  neutral:{label:'Species-rich grassland',kind:'Grassland',dist:4,dname:'Medium',col:'#A6C46A',desc:'Sown with green hay from the parish meadow. Knapweed, bird’s-foot trefoil and yellow rattle are establishing.'},
  meadow:{label:'Lowland meadow',kind:'Grassland',dist:6,dname:'High',col:'#9EBC62',desc:'Old hay meadow that has never been ploughed or fertilised. Cut late for hay, then grazed.'},
  chalk:{label:'Chalk grassland',kind:'Downland',dist:6,dname:'High',col:'#BEC28A',desc:'Short, flower-rich turf on thin chalk soil, kept open by sheep. Some of the richest habitat in Britain for plants and butterflies.'},
  scrub:{label:'Mixed scrub',kind:'Downland',dist:4,dname:'Medium',col:'#8E9A5E',desc:'Hawthorn, blackthorn and bramble spreading over old downland where grazing stopped. Good for nesting birds, but it is swallowing the chalk turf.'},
  ancient:{label:'Ancient woodland',kind:'Woodland',dist:8,dname:'Very high',col:'#3E5A2E',desc:'Wooded since at least 1600, with old soils and plants that spread only slowly. Irreplaceable.'},
  broadleaf:{label:'Broadleaved woodland',kind:'Woodland',dist:6,dname:'High',col:'#46602F',desc:'Mixed native woodland of oak, ash and hazel.'},
  plantation:{label:'Conifer plantation on ancient woodland site',kind:'Woodland',dist:4,dname:'Medium',col:'#2E463A',desc:'Rows of Corsican pine planted on what was once ancient woodland. The old soil and seed bank are still there.'},
  wetwood:{label:'Wet woodland',kind:'Woodland',dist:6,dname:'High',col:'#4A6A44',desc:'Alder and willow on waterlogged ground beside the brook.'},
  newwood:{label:'New native woodland',kind:'Woodland',dist:6,dname:'High',col:'#8AAA5A',desc:'Young native trees in guards: oak, hazel, field maple and wild cherry. It will take decades to become a real wood.'},
  woodpasture:{label:'Wood pasture',kind:'Grassland',dist:6,dname:'High',col:'#9AB666',desc:'Grazed grassland with scattered open-grown trees, the future veterans of the valley.'},
  riverbank:{label:'Chalk stream corridor',kind:'Water',dist:6,dname:'High',col:'#7FA35A',desc:'Wren Brook and its banks: clear chalk-fed water, with floodplain grassland either side.'},
  marsh:{label:'Coastal grazing marsh',kind:'Wetland',dist:4,dname:'Medium',col:'#8FA06A',desc:'Low wet pasture behind the sea wall, criss-crossed with ditches.'},
  shingle:{label:'Vegetated shingle',kind:'Coast',dist:8,dname:'Very high',col:'#D6CDB2',desc:'A ridge of flint pebbles with tough plants along the drift line. A rare habitat.'},
  gardens:{label:'Houses and gardens',kind:'Village',dist:1,dname:'Very low',nocond:true,col:'#7E9A58',desc:'Flint cottages and newer houses with gardens, walls and the odd old fruit tree.'},
  church:{label:'Churchyard',kind:'Village',dist:4,dname:'Medium',col:'#94AE68',desc:'St Mary’s church and its churchyard: grassland that has never been ploughed or fertilised.'},
  orchard:{label:'Traditional orchard',kind:'Village',dist:6,dname:'High',col:'#9AB666',desc:'Old apple and pear trees on grass, a few of them hollow with age.'},
  allotment:{label:'Allotments',kind:'Village',dist:2,dname:'Low',nocond:true,col:'#8E8A50',desc:'Vegetable plots, sheds and compost heaps.'},
  green:{label:'Village green',kind:'Village',dist:2,dname:'Low',nocond:true,col:'#9CB86A',desc:'Mown grass, a bench and a horse chestnut.'},
  dev:{label:'Building site',kind:'Development',dist:0,dname:'None',nocond:true,col:'#A88D62',desc:'Former pasture being built on. The developer must deliver 10% biodiversity net gain and can’t fit it all on site.'},
};
const CROPS=['#D8C37E','#A47F57','#A8BD63','#C9BE6C','#B9A766'];
const CROPINFO={
  '#D8C37E':{crop:'Wheat stubble',note:'Harvested in August. Stubble left over winter feeds seed-eating birds such as yellowhammer and linnet.',secret:'A covey of eleven grey partridge flushes from the stubble: a farmland bird in steep decline.'},
