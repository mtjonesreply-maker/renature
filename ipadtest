  for(const o in G.partners){const poor=PARCELS.filter(p=>p.owner===o&&!p.managed&&isSemi(p)&&!HAB[p.hab].nocond&&p.cond!=='Good');if(poor.length&&Math.random()<.5){const p=poor[Math.floor(Math.random()*poor.length)];p.cond=better(p.cond);ch=true}
    const cand=PARCELS.filter(p=>p.owner===o&&!p.managed&&['Farmland','Grassland','Downland'].includes(HAB[p.hab].kind)&&p.hedge<.95);if(cand.length){const p=cand[Math.floor(Math.random()*cand.length)];p.hedge=1;ch=true}}
