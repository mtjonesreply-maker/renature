const releaseOdds=()=>Math.max(50,95-6*Math.max(0,G.year-6));
const mineArea=(f)=>managed().filter(f).reduce((a,p)=>a+p.area,0);
function ladder(N){const R=[],woodNet=Math.max(0,...N.list.map(c=>c.ids.filter(id=>HAB[PARCELS[id].hab].kind==='Woodland').reduce((a,id)=>a+PARCELS[id].area,0)));
  const wetMine=mineArea(p=>['marsh','riverbank'].includes(p.hab)&&functional(p)),bankMine=mineArea(p=>p.hab==='riverbank'&&functional(p));
  const wetNet=Math.max(0,...N.list.filter(c=>c.habs.has('marsh')||c.habs.has('riverbank')).map(c=>c.area));
  R.push({k:'vole2',name:'Water voles, further up the brook',cost:300,ok:bankMine>=3,req:`Manage 3 ha of riverbank in good shape (you have ${ha(bankMine)} ha).`});
  R.push({k:'dormouse2',name:'Hazel dormice in a new wood',cost:400,ok:woodNet>=40,req:`A woodland network of 40 ha joined by hedges (largest is ${ha(woodNet)} ha).`});
  R.push({k:'stork',name:'White storks',flag:true,cost:1500,ok:wetMine>=15&&wetNet>=60,req:`Manage 15 ha of marsh and riverbank in good shape (you have ${ha(wetMine)} ha), in a network of 60 ha (largest wet network is ${ha(wetNet)} ha).`});
  R.push({k:'beaver',name:'Beavers on Wren Brook',flag:true,cost:2000,ok:bankMine>=8&&N.main.habs.has('riverbank')&&N.main.area>=80,req:`Manage 8 ha of riverbank in good shape (you have ${ha(bankMine)} ha), linked into a main network of 80 ha (now ${ha(N.main.area)} ha).`});
  R.push({k:'marten',name:'Pine martens',cost:1200,ok:woodNet>=100,req:`A woodland network of 100 ha (largest is ${ha(woodNet)} ha).`});
  for(const k in G.pops)if(G.pops[k].lost)R.unshift({k:'back_'+k,name:'Bring back '+POPS[k].name.toLowerCase(),cost:600,ok:functional(PARCELS[G.pops[k].p])&&(N.comp.get(G.pops[k].p)?.area||0)>=40,req:`Restore ${PARCELS[G.pops[k].p].name} and link it into a network of 40 ha.`});
  return R}
const inRecovery=p=>functional(p)||(p.managed&&(isSemi(p)||p.deal==='bank'||(p.project&&p.project.create)))||(G.partners[p.owner]&&isSemi(p));
function goalState(){const N=networks(),share=N.total?N.main.area/N.total:0,cover=PARCELS.filter(inRecovery).reduce((a,p)=>a+p.area,0)/LAND();return{N,share,cover,d2s:downsToSea(N.main)}}
function goalsSeason(){const {share,cover,d2s}=goalState();
  if(!G.keys.connect&&share>=GOALS.connect&&d2s){G.keys.connect=true;news('Key achieved: Connectivity','The valley’s habitats now form one network, from the Downs to the sea.');banner('Key achieved','Connectivity: Downs to sea, joined up.')}
  if(!G.keys.sustain){G.hold=cover>=GOALS.sustain?G.hold+1:0;if(G.hold>=GOALS.hold){G.keys.sustain=true;news('Key achieved: Sustainability',`Nature has held over 30% of the valley for ${GOALS.hold/4} years. It will last.`);banner('Key achieved','Sustainability: 30% of the valley, held for good.')}}
  checkComplete()}
function checkComplete(){if(G.complete||!G.keys.connect||!G.keys.sustain||!G.keys.reintro)return;G.complete=true;showComplete()}
function showComplete(){const {N,cover}=goalState();const el=document.getElementById('done');
  el.innerHTML=`<div class="donebox"><p class="eyebrow">Renature · Ashcombe Valley</p><h2>The valley is restored</h2>
    <p>In ${G.year} year${G.year===1?'':'s'} as ${PATHS[G.path].name}, you turned a scattered, declining valley into a living network from the Downs to the sea.</p>
    <dl class="stats"><dt>Land for nature</dt><dd>${Math.round(cover*100)}% of the valley</dd><dt>Joined-up habitat</dt><dd>${Math.round(N.main.area)} ha in one network</dd><dt>Species returned</dt><dd>${G.released.map(k=>RELNAME[k]||k).join(', ')}</dd><dt>Land you manage</dt><dd>${ha(managed().reduce((a,p)=>a+p.area,0))} ha</dd></dl>
    <p class="note-s">Free play is now open. Keep restoring, bring back more species, and enjoy what you have built.</p>
    <button class="btn primary" type="button" id="donebtn">Keep playing</button></div>`;
  el.hidden=false;document.getElementById('donebtn').onclick=()=>{el.hidden=true}}
document.addEventListener('DOMContentLoaded',()=>{});
const RELNAME={};
function renderGoals(){const el=document.getElementById('goalcard');if(!el||!G.keys)return;const {N,share,cover,d2s}=goalState(),R=ladder(N);R.forEach(r=>RELNAME[r.k]=r.name);
