// ================= deer =================
const DEER_W={ancient:2.2,broadleaf:2.2,newwood:2.4,wetwood:1.8,plantation:1.4,scrub:2,woodpasture:1.8,grass:1.2,neutral:1.3,meadow:1.3,crop:1,chalk:1,riverbank:1,marsh:.5,orchard:.7,church:.25,allotment:.25,green:.15,gardens:.1,shingle:0,dev:0};
const BROWSABLE=p=>HAB[p.hab].kind==='Woodland'||['scrub','woodpasture'].includes(p.hab);
function deerWeight(p){if(p.fenced||(p.project&&p.project.fence&&p.project.left<=0))return 0;let w=DEER_W[p.hab]??.5;if(p.cat==='village'||p.cat==='dev')w=Math.min(w,.1);if(p.dh>0)w*=.7;if(G.season===1&&HAB[p.hab].kind==='Woodland')w*=1.5;return w}
const nearestParcel=(x,y,ok)=>PARCELS.filter(ok).reduce((b,p)=>Math.hypot(p.cx-x,p.cy-y)<Math.hypot(b.cx-x,b.cy-y)?p:b);
function initDeer(){G.deer=[];G.deerLvl={};
  const pool=PARCELS.filter(q=>(DEER_W[q.hab]||0)>=1.3&&q.cat!=='village'),k=3+Math.floor(Math.random()*3);
  for(let tries=0;G.deer.length<k&&tries<500;tries++){let t=Math.random()*pool.reduce((a,q)=>a+DEER_W[q.hab],0),pick=pool[0];
    for(const q of pool){t-=DEER_W[q.hab];if(t<=0){pick=q;break}}
    if(G.deer.some(g=>Math.hypot(PARCELS[g.p].cx-pick.cx,PARCELS[g.p].cy-pick.cy)<160))continue;
    G.deer.push({p:pick.id,n:1+Math.floor(Math.random()*3)})}}
function pickMove(cur){const opts=[[cur,deerWeight(cur)*.8],...[...cur.nb].map(id=>PARCELS[id]).map(q=>[q,deerWeight(q)])].filter(o=>o[1]>0);
  if(!opts.length)return cur;let t=Math.random()*opts.reduce((a,o)=>a+o[1],0);for(const [q,w] of opts){t-=w;if(t<=0)return q}return opts[opts.length-1][0]}
function moveDeer(){for(const g of G.deer){let cur=PARCELS[g.p];const steps=deerWeight(cur)===0?2:1+Math.floor(Math.random()*3);for(let i=0;i<steps;i++)cur=pickMove(cur);g.p=cur.id}}
function displaceDeer(p){for(const g of G.deer)if(g.p===p.id){const nb=[...p.nb].map(id=>PARCELS[id]).filter(q=>deerWeight(q)>0).sort((a,b)=>deerWeight(b)-deerWeight(a));if(nb[0])g.p=nb[0].id}}
function deerPressure(p){return G.deer.reduce((a,g)=>{const q=PARCELS[g.p],d=Math.hypot(q.cx-p.cx,q.cy-p.cy);return a+g.n*Math.exp(-((d/65)**2))},0)}
const deerLevel=v=>v<.6?'Low':v<1.6?'Moderate':'High';
function deerSeason(){
  moveDeer();
  for(const p of managed()){if(p.dh>0)p.dh--;if(!BROWSABLE(p)||p.fenced)continue;const eff=deerPressure(p)*(p.dh>0?.4:1);
    if(p.project&&!p.project.fence&&eff>=1.6&&Math.random()<.6){p.browsed=true;news('Deer damage',`Deer browsed the regrowth at ${p.name}. The work there is set back a season.`)}
    else if(!p.project&&eff>=2&&p.cond!=='Poor'&&Math.random()<.25){p.cond=CONDS[CONDS.indexOf(p.cond)-1];news('Deer damage',`Heavy browsing at ${p.name}: no saplings are surviving and the ground flora is grazed bare. Condition drops to ${p.cond}.`)}}
  const bySite={};managed().filter(BROWSABLE).forEach(p=>{const k=p.site||p.name;bySite[k]=Math.max(bySite[k]||0,deerPressure(p))});
  for(const k in bySite){const l=deerLevel(bySite[k]),prev=G.deerLvl[k];if(prev&&prev!==l){const nm=SITE_NAMES[k]||k,up=['Low','Moderate','High'].indexOf(l)>['Low','Moderate','High'].indexOf(prev);news('Deer',`Deer have ${up?'moved in around':'drifted away from'} ${nm}. Browsing pressure is now ${l.toLowerCase()}.`)}G.deerLvl[k]=l}
}
