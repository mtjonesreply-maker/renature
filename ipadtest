  ctx.save();ctx.scale(2,2);ctx.lineJoin='round';ctx.lineCap='round';
  const r=rng(7);
  for(const cell of CELLS){if(cell.parcel)paintCell(ctx,cell,cell.parcel,r)}
  // boundaries: hedges, rides, fences, ditches
  const at=(c,rr)=>c>=0&&c<COLS&&rr>=0&&rr<ROWS?CELLS[rr*COLS+c]:null;
  const edge=(a,b,p0,p1,road)=>{
    if(!a||!b||!a.parcel||!b.parcel||a.parcel===b.parcel||road)return;
    const A=a.parcel,B=b.parcel,ka=HAB[A.hab].kind,kb=HAB[B.hab].kind;
    if(ka==='Woodland'&&kb==='Woodland'&&A.ent===B.ent){ctx.strokeStyle='rgba(225,215,170,.45)';ctx.lineWidth=1;ctx.setLineDash([3,3]);ctx.beginPath();ctx.moveTo(...p0);ctx.lineTo(...p1);ctx.stroke();ctx.setLineDash([]);return}
    if(ka==='Village'&&kb==='Village'){ctx.strokeStyle='rgba(90,75,55,.7)';ctx.lineWidth=.8;ctx.beginPath();ctx.moveTo(...p0);ctx.lineTo(...p1);ctx.stroke();return}
    if(A.hab==='marsh'||B.hab==='marsh'||A.hab==='shingle'||B.hab==='shingle'){ctx.strokeStyle='#5E8EA2';ctx.lineWidth=1.3;ctx.beginPath();ctx.moveTo(...p0);ctx.lineTo(...p1);ctx.stroke();return}
    if(ka==='Downland'&&kb==='Downland'){ctx.strokeStyle='rgba(110,90,60,.5)';ctx.lineWidth=.7;ctx.beginPath();ctx.moveTo(...p0);ctx.lineTo(...p1);ctx.stroke();return}
    // a hedgerow: gappy where it hasn't been managed
    const qa=ka==='Woodland'?1:A.hedge,qb=kb==='Woodland'?1:B.hedge,qual=Math.min(qa,qb);
    const L=Math.hypot(p1[0]-p0[0],p1[1]-p0[1]),n=Math.ceil(L/3.2);
    for(let i=0;i<=n;i++){const t=i/n,x=p0[0]+(p1[0]-p0[0])*t,y=p0[1]+(p1[1]-p0[1])*t;const seg=hash(Math.round(x*3),Math.round(y*3));
      if(seg<qual){blobC(ctx,x+.8,y+.9,2.4,2.1,'rgba(20,30,10,.35)');blobC(ctx,x,y,2.3,2.3,seg<qual*.5?'#2F4A28':'#3B5A2E')}
      if(seg>.965&&qual>.3){blobC(ctx,x+1.5,y+1.8,4.8,4.2,'rgba(20,30,10,.35)');blobC(ctx,x,y,4.6,4.6,['#6E7A34','#9A7A2E','#B8772F'][Math.floor(seg*1000)%3])}}
  };
  for(let rr=0;rr<ROWS;rr++)for(let c=0;c<COLS;c++){const a=at(c,rr);
    edge(a,at(c+1,rr),V[c+1][rr],V[c+1][rr+1],ROADS.has(vkey('v',c+1,rr)));
    edge(a,at(c,rr+1),V[c][rr+1],V[c+1][rr+1],ROADS.has(vkey('h',c,rr+1)));}
  // river
  const rp=[];for(let y=-5;y<=716;y+=4)rp.push([riverX(y),y]);
  ctx.strokeStyle='#4E8099';for(let i=1;i<rp.length;i++){ctx.lineWidth=riverW(rp[i][1])*2+1.6;ctx.beginPath();ctx.moveTo(...rp[i-1]);ctx.lineTo(...rp[i]);ctx.stroke()}
  ctx.strokeStyle='#76A9BF';for(let i=1;i<rp.length;i++){ctx.lineWidth=riverW(rp[i][1])*2-1;ctx.beginPath();ctx.moveTo(...rp[i-1]);ctx.lineTo(...rp[i]);ctx.stroke()}
  for(let y=10;y<640;y+=13){const w=riverW(y);[-1,1].forEach(sd=>{if(r()<.5){const x=riverX(y)+sd*(w+5+r()*3);blobC(ctx,x+1.5,y+2,4,3.4,'rgba(20,30,10,.35)');blobC(ctx,x,y,3.8,3.8,['#4E7A3A','#5F8B42','#6E8A3E'][Math.floor(r()*3)])}})}
  // roads along the grid
  const road=pts=>{ctx.beginPath();pts.forEach((p,k)=>k?ctx.lineTo(...p):ctx.moveTo(...p));ctx.strokeStyle='#4E5A36';ctx.lineWidth=6.5;ctx.stroke();ctx.strokeStyle='#5F5641';ctx.lineWidth=4.6;ctx.stroke();ctx.strokeStyle='#E2D9BF';ctx.lineWidth=2.8;ctx.stroke()};
  road(Array.from({length:COLS+1},(_,c)=>V[c][19]).filter(p=>p[1]<coastY(p[0])));
  road(Array.from({length:20},(_,rr)=>V[28][rr]));
  road([...Array.from({length:7},(_,k)=>V[19][19+k]),...Array.from({length:11},(_,k)=>V[20+k][25])]);
  road(Array.from({length:10},(_,k)=>V[12][10+k]));
  const bx=riverX(V[33][19][1]);ctx.fillStyle='#B9AE92';ctx.fillRect(bx-9,V[33][19][1]-4,18,8);
  // sea texture over the coast cells
  ctx.strokeStyle='rgba(220,240,245,.25)';ctx.lineWidth=1;
  for(let i=0;i<90;i++){const x=r()*1200,y=coastY(x)+12+r()*50;if(y<750){ctx.beginPath();ctx.moveTo(x,y);ctx.quadraticCurveTo(x+6,y-3,x+12,y);ctx.stroke()}}
  ctx.restore();
}

