document.getElementById('help').onclick = () => { if (G.over) return; G.running = false; G.peek = false; document.getElementById('brief').hidden = true; document.getElementById('peekbar').hidden = true; document.getElementById('start').textContent = !UNITS.length ? 'Back to the briefing' : 'Back to work'; document.getElementById('intro').hidden = false; };
document.getElementById('endday').onclick = () => { if (G.running) finish(); };
document.getElementById('early').onclick = () => { if (!G.running) return; G.early = true; const left = Math.max(0, 900 - G.t); const bonus = Math.min(5, 1 + Math.round(left / 40)); G.gw = Math.min(100, G.gw + bonus); log(`Finished early. The crew heads home happy, ${Math.round(left)} minutes ahead of time.`, 'good'); finish(); };

// ===================== events =====================
function events(){
  const E = G.events;
  if (!E.tea && G.t > 640 && UNITS.reduce((a, u) => a + u.stamina, 0) / UNITS.length < 45){ E.tea = 1; log('Sam asks if it’s time for tea yet. The crew are flagging: call a tea break before someone is worn out.', 'info'); toast('The crew are flagging. Time for a tea break?'); }
  if (G.t >= 780 && !E.walker){ E.walker = 1; const gs = computeGoals(), lit = OBJS.filter(o => DEF[o.type].cat === 'litter' && !LOCK.has(o.zone)), litLeft = lit.filter(o => o.state === 'present').length;
    if (gs.none){ G.gw = Math.min(100, G.gw + 1); log(`A dog walker stops by: "It's really coming back, this bit." The crew agree.`, 'good'); }
    else if (gs.pct >= 50 && !litLeft){ G.gw = Math.min(100, G.gw + 3); log(`A dog walker stops to watch: "You can actually see into ${PLACE} now." Two of them ask about volunteering.`, 'good'); toast('A dog walker noticed the progress. Goodwill up.'); }
    else if (gs.pct >= 50){ G.gw = Math.min(100, G.gw + 1); log(`A dog walker stops to chat: "Good work, but shame about that rubbish still lying about."`, 'info'); }
    else if (gs.pct >= 20){ log('A dog walker nods as they pass. Not much to see yet.', 'info'); }
    else { G.gw = Math.max(0, G.gw - 1); log('A dog walker asks what the crew have actually been doing all morning.', 'bad'); } }
  if (G.t >= 870 && !E.late){ E.late = 1; log('Half an hour left. Start bringing loads back to the meet point.', 'info'); toast('Half an hour left.'); }
  if (G.t >= 900) finish();
}

// ===================== report =====================
function finish(){
  if (G.over) return; G.over = true; G.running = false; closeMenu();
  const ob = BEFORE, oa = assessTile();
  const untreated = OBJS.filter(o => DEF[o.type].inv && o.state === 'stump').length;
  const leftLoads = OBJS.reduce((a, o) => a + o.loads.length, 0) + UNITS.reduce((a, u) => a + u.carrying.length, 0);
  const coppiced = OBJS.filter(o => o.type === 'hazel' && o.state === 'coppiced' && o.age === 0).length;
  const notes = [], l0 = floorLight(L0), l1 = floorLight(LIGHT);
  if (l1 - l0 > .03) notes.push(`<b>More light on the floor: ${pct(l0)} → ${pct(l1)}.</b> Woodland flowers (bluebell, wood anemone, primrose) will spread into the new gaps over the next few seasons. Bramble will race them for the same light.`);
  if (oa.ind.flowers < 3) notes.push(`<b>Woodland flowers: ${floraWord(oa.flora)}.</b> They are what lifts this compartment to Good, and they only come back season by season, not in a single day.`);
  if (G.nesting) notes.push(`<b>Cut during the nesting season (${G.nesting}).</b> Shrub and scrub work is best left to autumn and winter, March to August is when birds nest in it. Goodwill took a knock.`);
  if (G.cutback) notes.push(`<b>${G.cutback} patch${G.cutback > 1 ? 'es' : ''} of bramble, dogwood or nettles cut back.</b> The flowers underneath get a chance, but bramble and dogwood will be back from the roots next spring, and nettles next season. Keep coming back to it.`);
  if (G.harvested.length){ const c = {}; G.harvested.forEach(n => c[n] = (c[n] || 0) + 1); notes.push(`<b>Cut for produce:</b> ${Object.entries(c).map(([n, k]) => `${n.toLowerCase()} ×${k}`).join(', ')}. Fewer native shrubs for birds and insects, more light for the flowers, and something to sell. They regrow from the stump in a year or so.`); }
  if (untreated) notes.push(`<b>${untreated} cleared clump${untreated > 1 ? 's' : ''} left untreated.</b> Expect regrowth from the stumps by next autumn; it will show up as invasive cover again.`);
  if (ZMAP.brook && !LOCK.has('brook')) notes.push('<b>Balsam in Brook gully</b> could not be tackled in October. Put a pulling day in the calendar for June, before it flowers.');
  if (coppiced) notes.push(`<b>${coppiced} hazel stool${coppiced > 1 ? 's' : ''} coppiced.</b> Deer will browse the regrowth in spring unless the stools are protected.`);
  if (G.removedDeadwood) notes.push(`<b>Deadwood sold as firewood (${G.removedDeadwood}).</b> It paid, but beetles and fungi lost a home.`);
  if (G.mistakes.length) notes.push(`<b>Mistakes:</b> ${G.mistakes.join('; ')}. Volunteers with a good eye for plants catch these; Priya rarely misses one.`);
  if (leftLoads) notes.push(`<b>${leftLoads} load${leftLoads > 1 ? 's' : ''} left in the wood</b> at the end of the day. Brash left out still counts as cleared, but produce left behind earns nothing.`);
  if (G.early) notes.unshift(`<b>Finished early at ${document.getElementById('clock').textContent}.</b> Every job on the list was done, and the crew went home happy. Goodwill is up, and volunteers who enjoy a day are more likely to come back.`);
  const gsum = computeGoals(); notes.unshift(`<b>Jobs done: ${gsum.pct}%.</b> ${gsum.list.filter(g => !g.keep).map(g => `${g.name} ${g.done}/${g.total}`).join(' · ')}`);
  const v = bankValue(), sold = v + G.skipCost;
  const rows = Object.keys({...ob.ind, ...oa.ind}).map(k => { const b = ob.ind[k], a = oa.ind[k]; return `<tr><td>${INDNAME[k]}</td><td class="band ${BANDOF(b)}">${BANDOF(b)}</td><td class="band ${BANDOF(a)}">${BANDOF(a)}</td><td>${a > b ? '↑' : a < b ? '↓' : ''}</td></tr>`; }).join('');
  const prod = [['Hazel poles', 'poles'], ['Pea sticks', 'peasticks'], ['Firewood', 'firewood'], ['Holly greenery', 'greenery'], ['Woodchip', 'woodchip'], ['Nettle tops', 'nettles']].filter(([, k]) => G.bank[k]).map(([n, k]) => `${n} ×${G.bank[k]}`).join(', ');
  const rep = document.getElementById('report');
  rep.innerHTML = `<div class="sheet"><p class="eyebrow">Condition report · ${document.getElementById('clock').textContent}</p><h2>${PLACE}: ${ob.band} → ${oa.band}</h2>
    <div class="tablewrap"><table><thead><tr><th>Indicator</th><th>This morning</th><th>Now</th><th></th></tr></thead><tbody>${rows}
      <tr><td>Light on the floor</td><td>${pct(l0)}</td><td>${pct(l1)}</td><td>${l1 - l0 > .03 ? '↑' : ''}</td></tr></tbody></table></div>
    <div class="tablewrap"><table><tbody>
      <tr><td>Produce sold${prod ? ` (${prod})` : ''}</td><td class="num">£${sold}</td></tr>
      <tr><td>Invasive brash burnt on site (${G.bank.burnt} load${G.bank.burnt === 1 ? '' : 's'}): no value</td><td class="num">£0</td></tr>
      <tr><td>Skip disposal (${G.skipItems} item${G.skipItems === 1 ? '' : 's'})</td><td class="num">${G.skipCost ? '−£' + G.skipCost : '£0'}</td></tr>
      ${G.guards ? `<tr><td>Tree guards (${G.guards} × £${GUARD_COST})</td><td class="num">−£${G.guards * GUARD_COST}</td></tr>` : ''}${G.treated ? `<tr><td>Herbicide (${G.treated} stump${G.treated === 1 ? '' : 's'} × £${HERB_COST})</td><td class="num">−£${G.treated * HERB_COST}</td></tr>` : ''}
      <tr><td><b>Net for the day</b></td><td class="num"><b>${v < 0 ? '−£' : '£'}${Math.abs(v)}</b></td></tr>
      <tr><td>Goodwill</td><td class="num">${Math.round(G.gw0)}% → ${Math.round(G.gw)}%</td></tr>
    </tbody></table></div>
    ${notes.map(n => `<p class="note">${n}</p>`).join('')}
    <div class="row"><button class="btn" type="button" id="minrep">View the wood</button>${EMBED ? '<button class="btn primary" type="button" id="back">Return to the valley</button>' : ''}</div></div>`;
  rep.hidden = false;
  document.getElementById('minrep').onclick = () => { rep.hidden = true; document.getElementById('repmin').hidden = false; };
  document.getElementById('repshow').onclick = () => { rep.hidden = false; document.getElementById('repmin').hidden = true; };
  if (EMBED) document.getElementById('back').onclick = () => parent.postMessage({type:'renature-workday', vols:G.party || UNITS.length, net:v, gw:G.gw - G.gw0, band:oa.band, before:ob.band, mistakes:G.mistakes.length, early:G.early, jobs:gsum.none ? null : gsum.pct, flora:encodeFlora(),
      objs:packObjs(), events:SEASON_EVENTS.filter(e => /veteran|came down|blown|fungus|collapsed|crown/.test(e[0])).map(e => e[0])}, '*');
  log('Tools cleaned, counted and back in the trailer.', 'info'); renderSide(true);
}

// ===================== loop =====================
let last = performance.now();
function frame(now){
  const dt = Math.min(0.1, (now - last) / 1000); last = now;
  if (G.running && G.speed){ const gdt = dt * G.speed; const n = Math.ceil(G.speed); for (let i = 0; i < n; i++){ G.t += gdt / n; UNITS.forEach(u => step(u, gdt / n)); } events(); }
  OBJS.forEach(o => { if (o.flash > 0) o.flash = Math.max(0, o.flash - dt * 1.2); });
  draw(); renderSide(false);
  requestAnimationFrame(frame);
}
window.addEventListener('resize', resize);
window.addEventListener('message', e => { const d = e.data; if (!d || d.type !== 'renature-init') return;
  LOCK.clear(); (d.locked || []).forEach(z => LOCK.add(z)); INIT = {tools:d.tools || ['saws'], maxVols:Math.min(12, d.vols || 6), crewFrom:d.crewFrom || 0, staff:d.staff || 0, gw:d.goodwill ?? 58, states:d.states || null, objs:d.objs || null, flora:d.flora || null, seasons:d.seasons || 0, creep:d.creep || 0, cond:d.cond || null, gw:d.goodwill ?? 58}; SEASON = d.season || 'Autumn';
  if (d.card) applyCard(d.card);
  if (d.date) document.querySelector('.brand small').textContent = 'Renature · ' + d.date;
  document.querySelector('#intro .eyebrow').textContent = d.date || 'Work day';
  reset(); resize(); });
if (EMBED){ document.body.classList.add('embed'); }
reset(); resize(); buildBG(); requestAnimationFrame(frame);
if (EMBED) parent.postMessage({type:'renature-ready'}, '*');
if (document.fonts) document.fonts.ready.then(() => { OBJS.forEach(o => o.sprite = null); });
</script>
