    for (; j > i + 1; j--){ worst = 0; for (let k = i; k <= j; k++) worst = Math.max(worst, COST[cells[k]]); if (lineOK(pts[i], pts[j], worst)) break; }
    out.push(pts[j]); i = j; }
  out.shift(); out.push([tx, ty]); return out;
}
function lineOK(a, b, worst){ const n = Math.ceil(Math.hypot(b[0] - a[0], b[1] - a[1]) / (GC / 2)); for (let k = 1; k < n; k++){ const x = a[0] + (b[0] - a[0]) * k / n, y = a[1] + (b[1] - a[1]) * k / n; const [c, r] = cellOf(x, y), v = COST[r * GW + c]; if (v === Infinity || v > worst + .01) return false; } return true; }
function pathTo(u, tx, ty){ const [c, r] = freeCell(...cellOf(tx, ty)); const p = astar(u.x, u.y, (c + .5) * GC, (r + .5) * GC); p[p.length - 1] = COST[cellOf(tx, ty)[1] * GW + cellOf(tx, ty)[0]] === Infinity ? [(c + .5) * GC, (r + .5) * GC] : [tx, ty]; return p; }

// ===================== objects =====================
const DEF = {
