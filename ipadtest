const SEMI=new Set(['ancient','broadleaf','wetwood','newwood','scrub','woodpasture','neutral','meadow','chalk','riverbank','marsh','shingle','church','orchard']);
const isSemi=p=>SEMI.has(p.hab);
const functional=p=>isSemi(p)&&(HAB[p.hab].nocond||p.cond!=='Poor');
const connector=p=>!functional(p)&&(p.margins||p.hedge>=.95);
const LAND=()=>PARCELS.reduce((a,p)=>a+p.area,0);
function networks(){const comp=new Map(),list=[];
  for(const p of PARCELS){if(!functional(p)||comp.has(p.id))continue;const c={id:list.length,ids:[],links:[],area:0,cats:new Set(),habs:new Set()};list.push(c);
    const st=[p],vis=new Set([p.id]);
    while(st.length){const q=st.pop();if(functional(q)){c.ids.push(q.id);c.area+=q.area;c.cats.add(q.cat);c.habs.add(q.hab);comp.set(q.id,c)}else c.links.push(q.id);
      for(const id of q.nb){if(vis.has(id))continue;const r=PARCELS[id];if(!functional(r)&&!connector(r))continue;vis.add(id);st.push(r)}}}
  list.sort((a,b)=>b.area-a.area);const total=list.reduce((a,c)=>a+c.area,0);
  return{list,comp,total,main:list[0]||{ids:[],links:[],area:0,cats:new Set(),habs:new Set()}}}
const downsToSea=c=>c.cats.has('down')&&(c.cats.has('shingle')||c.cats.has('marsh'));
function gapParcels(N){return PARCELS.filter(p=>!functional(p)&&!connector(p)&&p.cat!=='dev'&&p.cat!=='village'&&!isFogged(p.cx,p.cy)).map(p=>{const cs=[...new Map([...p.nb].map(id=>N.comp.get(id)).filter(Boolean).map(c=>[c.id,c])).values()];return{p,n:cs.length,gain:cs.reduce((a,c)=>a+c.area,0)-Math.max(0,...cs.map(c=>c.area))}}).filter(x=>x.n>=2).sort((a,b)=>b.gain-a.gain).slice(0,6).map(x=>x.p)}

