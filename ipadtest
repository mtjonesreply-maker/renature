<script>
// ===================== world =====================
const W = 1600, H = 1000;
let ZONES = [
  {id:'ash', name:'Ash scarp', x:40, y:40, w:480, h:375, node:'RL', ind:['invasive','natives','deadwood','groundflora'], tint:''},
  {id:'rhodo', name:'Rhododendron thicket', x:540, y:40, w:520, h:375, node:'RC', ind:['invasive','natives','veteran','groundflora'], tint:''},
  {id:'brook', name:'Brook gully', x:1080, y:40, w:480, h:375, node:'RR', ind:['invasive','disturbance','groundflora'], tint:'rgba(40,70,60,.22)'},
  {id:'coppice', name:'Old coppice', x:40, y:455, w:480, h:320, node:'TL', ind:['structure','regen','deadwood'], tint:'rgba(150,130,40,.14)'},
  {id:'bluebell', name:'Bluebell hollow', x:540, y:455, w:520, h:320, node:'T0', ind:['invasive','natives','veteran','regen','groundflora'], tint:'rgba(40,40,80,.16)'},
  {id:'lane', name:'Lane edge', x:1080, y:455, w:480, h:320, node:'TR', ind:['disturbance','regen','invasive'], tint:'rgba(110,100,70,.14)'},
];
let ZMAP = Object.fromEntries(ZONES.map(z => [z.id, z]));
let MEET = {x:600, y:815, w:400, h:140};
let MO = [MEET.x - 600, MEET.y - 815], MK = 1;
const mx = x => MEET.x + (x - 600) * MK, my = y => MEET.y + (y - 815) * MK;
const NODES = {M:[800,880], T0:[800,795], TL:[280,795], TR:[1320,795], TA:[530,795], TB:[1070,795], RA:[530,435], RB:[1070,435], RL:[280,435], RC:[800,435], RR:[1320,435]};
const EDGES = [['M','T0'],['T0','TA'],['TA','TL'],['T0','TB'],['TB','TR'],['TA','RA'],['TB','RB'],['RA','RL'],['RA','RC'],['RB','RC'],['RB','RR']];
let BROOK = []; for (let t = 0; t <= 1.0001; t += 0.02) BROOK.push([1090 + t * 470 + Math.sin(t * 9) * 30, 45 + t * 365 + Math.cos(t * 7) * 20]);
function catmull(P, n){ const out = []; for (let i = 0; i < P.length - 1; i++){ const p0 = P[Math.max(0, i - 1)], p1 = P[i], p2 = P[i + 1], p3 = P[Math.min(P.length - 1, i + 2)];
  for (let k = 0; k < n; k++){ const t = k / n, t2 = t * t, t3 = t2 * t; out.push([.5 * ((2 * p1[0]) + (-p0[0] + p2[0]) * t + (2 * p0[0] - 5 * p1[0] + 4 * p2[0] - p3[0]) * t2 + (-p0[0] + 3 * p1[0] - 3 * p2[0] + p3[0]) * t3),
    .5 * ((2 * p1[1]) + (-p0[1] + p2[1]) * t + (2 * p0[1] - 5 * p1[1] + 4 * p2[1] - p3[1]) * t2 + (-p0[1] + 3 * p1[1] - 3 * p2[1] + p3[1]) * t3)]); } } out.push(P[P.length - 1]); return out; }
let RIDES = [
  {w:22, pts:catmull([[30,446],[190,428],[360,452],[560,430],[760,452],[960,428],[1110,450],[1300,426],[1460,446],[1575,432]], 12)},
  {w:22, pts:catmull([[30,800],[170,786],[330,806],[530,790],[720,806],[880,788],[1070,808],[1260,788],[1430,804],[1575,792]], 12)},
  {w:18, pts:catmull([[560,430],[520,520],[548,610],[516,700],[530,790]], 12)},
  {w:18, pts:catmull([[1110,450],[1088,540],[1112,640],[1076,720],[1070,808]], 12)},
  {w:18, pts:catmull([[800,795],[796,820],[802,846]], 6)},
];
let FOOTPATH = catmull([[40,110],[170,128],[300,170],[420,240],[520,330],[560,430]], 10);
let TRACKS = [FOOTPATH];
const onTrack = (x, y) => TRACKS.some(P => P.length && distToLine(P, x, y) < 9);
let BRIDGES = BROOK.length ? [[0.3, 0], [0.72, 0]].map(([t]) => BROOK[Math.round(t * (BROOK.length - 1))]) : [];
function distToLine(P, x, y){ let m = 1e9; for (let i = 1; i < P.length; i++){ const [ax, ay] = P[i - 1], [bx, by] = P[i]; const dx = bx - ax, dy = by - ay, t = Math.max(0, Math.min(1, ((x - ax) * dx + (y - ay) * dy) / (dx * dx + dy * dy || 1))); m = Math.min(m, Math.hypot(ax + dx * t - x, ay + dy * t - y)); } return m; }
const onRide = (x, y) => RIDES.some(r => distToLine(r.pts, x, y) < r.w / 2 + 2);
const dropFor = () => Object.fromEntries(Object.entries({brash:[668,912], poles:[792,930], peasticks:[792,930], greenery:[792,930], woodchip:[720,930], nettles:[792,930], firewood:[872,926], litter:[948,902], item:[905,858]}).map(([k, [x, y]]) => [k, [mx(x), my(y)]]));
let DROP = dropFor();

function rng(seed){return function(){seed|=0;seed=seed+0x6D2B79F5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
const inRect = (x, y, r) => x >= r.x && x <= r.x + r.w && y >= r.y && y <= r.y + r.h;
function zoneAt(x, y){ for (const z of ZONES) if (inRect(x, y, z)) return z.id; if (inRect(x, y, MEET)) return 'meet'; return 'ride'; }
function nearestNode(x, y){ let b = null, bd = 1e9; for (const k in NODES){ const d = Math.hypot(NODES[k][0]-x, NODES[k][1]-y); if (d < bd){ bd = d; b = k; } } return b; }
function route(a, b){
  const dist = {}, prev = {}, Q = new Set(Object.keys(NODES));
  for (const k of Q) dist[k] = Infinity; dist[a] = 0;
  while (Q.size){ let u = null; for (const k of Q) if (u === null || dist[k] < dist[u]) u = k; Q.delete(u); if (u === b) break;
    for (const [p, q] of EDGES){ const v = p === u ? q : q === u ? p : null; if (!v || !Q.has(v)) continue;
      const d = dist[u] + Math.hypot(NODES[u][0]-NODES[v][0], NODES[u][1]-NODES[v][1]); if (d < dist[v]){ dist[v] = d; prev[v] = u; } } }
  const out = [b]; while (out[0] !== a) out.unshift(prev[out[0]]); return out;
}
// ---- free movement: cost grid + A* ----
const GC = 10, GW = W / GC, GH = H / GC; let COST = null;
const THICK = {blackthorn:1.9, rhodo:2.3, rhodoSmall:1.5, laurel:1.9, bramble:2.0, holly:1.5, hazel:1.5, hawthorn:1.4, elder:1.3};
function buildCost(){ const C = new Float32Array(GW * GH).fill(1);
  for (let r = 0; r < GH; r++) for (let c = 0; c < GW; c++){ const x = (c + .5) * GC, y = (r + .5) * GC, i = r * GW + c;
    if ((OUTLINE ? !inPlay(x, y) : y > 948) || x < 6 || x > W - 6 || y < 6){ C[i] = Infinity; continue; }
    if (onRide(x, y)) C[i] = .6; else if (onTrack(x, y)) C[i] = .8;
    if (distToBrook(x, y) < 15 && !BRIDGES.some(b => Math.hypot(b[0] - x, b[1] - y) < 24)) C[i] = Infinity; }
  for (const o of OBJS){ const d = DEF[o.type];
    if (d.canopy && (isCanopyNow(o) || o.type === 'veteran')){ stamp(C, o.x, o.y, d.trunk + 7, Infinity); continue; }
    if (o.type === 'ash' && o.state === 'felled'){ stamp(C, o.x, o.y, 22, 2.2); continue; }
    const th = THICK[o.type]; if (th && (o.state === 'present' || (o.type === 'hazel' && o.state === 'present'))) stamp(C, o.x, o.y, o.r * .85, th, true); }
  COST = C; }
function stamp(C, x, y, R, v, maxOnly){ const c0 = Math.max(0, Math.floor((x - R) / GC)), c1 = Math.min(GW - 1, Math.floor((x + R) / GC)), r0 = Math.max(0, Math.floor((y - R) / GC)), r1 = Math.min(GH - 1, Math.floor((y + R) / GC));
  for (let r = r0; r <= r1; r++) for (let c = c0; c <= c1; c++){ if (Math.hypot((c + .5) * GC - x, (r + .5) * GC - y) > R) continue; const i = r * GW + c; if (C[i] === Infinity) continue; C[i] = maxOnly ? Math.max(C[i] === .6 ? 1 : C[i], v) : v; } }
const cellOf = (x, y) => [Math.min(GW - 1, Math.max(0, Math.floor(x / GC))), Math.min(GH - 1, Math.max(0, Math.floor(y / GC)))];
function costAt(x, y){ if (!COST) return 1; const [c, r] = cellOf(x, y); const v = COST[r * GW + c]; return v === Infinity ? 1.5 : v; }
function freeCell(c, r){ if (COST[r * GW + c] !== Infinity) return [c, r]; for (let rad = 1; rad < 12; rad++) for (let dr = -rad; dr <= rad; dr++) for (let dc = -rad; dc <= rad; dc++){ const cc = c + dc, rr = r + dr; if (cc < 0 || rr < 0 || cc >= GW || rr >= GH) continue; if (COST[rr * GW + cc] !== Infinity) return [cc, rr]; } return [c, r]; }
function astar(sx, sy, tx, ty){
  if (!COST) buildCost();
  let [c0, r0] = freeCell(...cellOf(sx, sy)), [c1, r1] = freeCell(...cellOf(tx, ty)); const S = r0 * GW + c0, T = r1 * GW + c1, N = GW * GH;
  const g = new Float32Array(N).fill(Infinity), prev = new Int32Array(N).fill(-1), closed = new Uint8Array(N); const heap = [];
  const push = (i, f) => { heap.push([f, i]); let k = heap.length - 1; while (k){ const p = (k - 1) >> 1; if (heap[p][0] <= heap[k][0]) break; [heap[p], heap[k]] = [heap[k], heap[p]]; k = p; } };
  const pop = () => { const top = heap[0], last = heap.pop(); if (heap.length){ heap[0] = last; let k = 0; for (;;){ const l = 2 * k + 1, r = l + 1; let m = k; if (l < heap.length && heap[l][0] < heap[m][0]) m = l; if (r < heap.length && heap[r][0] < heap[m][0]) m = r; if (m === k) break; [heap[m], heap[k]] = [heap[k], heap[m]]; k = m; } } return top; };
