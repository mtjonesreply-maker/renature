let BASE=null;
function blobC(g,x,y,rx,ry,col,a=0){g.fillStyle=col;g.beginPath();g.ellipse(x,y,rx,ry,a,0,Math.PI*2);g.fill()}
function paintCell(g,cell,p,r){
  const q=cell.q,H=HAB[p.hab];
  g.save();g.beginPath();q.forEach((pt,i)=>i?g.lineTo(pt[0],pt[1]):g.moveTo(pt[0],pt[1]));g.closePath();g.clip();
  const [x0,y0,x1,y1]=bbox(q),w=x1-x0,h=y1-y0,cx=cell.cx,cy=cell.cy;
  const base=p.hab==='crop'?p.crop:H.col;
  g.globalAlpha=.86;g.fillStyle=base;g.fillRect(x0-1,y0-1,w+2,h+2);g.globalAlpha=1;
  const dots=(n,cols,rad)=>{for(let i=0;i<n;i++)blobC(g,x0+r()*w,y0+r()*h,rad*(.6+r()*.6),rad*(.6+r()*.6),cols[i%cols.length])};
  switch(p.hab){
    case'crop':{if(p.margins){g.strokeStyle='#C9C77A';}
      const stripe=p.crop==='#A47F57'?'rgba(70,48,25,.35)':p.crop==='#A8BD63'?'rgba(60,90,40,.3)':'rgba(255,245,200,.32)';
      g.strokeStyle=stripe;g.lineWidth=.8;const a=p.angle;for(let s=-40;s<40;s+=3){g.beginPath();g.moveTo(cx+Math.cos(a)*-40-Math.sin(a)*s,cy+Math.sin(a)*-40+Math.cos(a)*s);g.lineTo(cx+Math.cos(a)*40-Math.sin(a)*s,cy+Math.sin(a)*40+Math.cos(a)*s);g.stroke()}
      break}
    case'grass':dots(14,['#7EA24E','#9BBD62'],1.6);break;
    case'neutral':dots(20,['#F2E27A','#FFFFFF','#B58AD0','#E8A3B8','#8FB25A'],1.1);break;
    case'meadow':dots(34,['#F2E27A','#FFFFFF','#B58AD0','#E8A3B8'],1.1);break;
    case'chalk':dots(16,['#E9E6D5','#D7D3A8','#B8C08A'],1.3);break;
    case'scrub':dots(6,['#C8C59A'],1.2);dots(9,['#4E6A35','#5D7A3C','#6A5A2E'],4.2);break;
    case'ancient':case'broadleaf':{const P=p.cond==='Good'?['#5E7A30','#7B8A30','#A98A2E','#4F6A2A','#B9772A']:['#3F6B34','#557A3A','#6E8A3E','#A38A3A','#B8772F','#2F5A2E'];
      for(let i=0;i<7;i++){const x=x0+r()*w,y=y0+r()*h,s=5+r()*4;blobC(g,x+2,y+2.5,s,s*.85,'rgba(20,24,10,.35)');blobC(g,x,y,s,s,P[i%P.length]);blobC(g,x-s*.3,y-s*.35,s*.5,s*.4,'rgba(255,250,210,.16)')}break}
    case'wetwood':for(let i=0;i<6;i++){const x=x0+r()*w,y=y0+r()*h,s=4.5+r()*3;blobC(g,x,y,s,s,['#4E7A3A','#5F8B42','#3E6A34'][i%3])}dots(3,['#7FB0C6'],2);break;
    case'plantation':for(let yy=y0+3;yy<y1;yy+=6)for(let xx=x0+3;xx<x1;xx+=6){blobC(g,xx+1.5,yy+1.5,2.8,2.8,'rgba(10,20,15,.4)');blobC(g,xx,yy,2.8,2.8,r()<.5?'#2A4A3A':'#33523E')}break;
    case'newwood':for(let yy=y0+3;yy<y1;yy+=5)for(let xx=x0+3;xx<x1;xx+=5)blobC(g,xx,yy,1.1,1.1,'#E6EBD6');break;
    case'woodpasture':for(let i=0;i<2;i++){const x=x0+4+r()*(w-8),y=y0+4+r()*(h-8);blobC(g,x+2,y+2,6,5,'rgba(20,24,10,.3)');blobC(g,x,y,6,6,['#6E7A34','#8A8434'][i])}break;
    case'riverbank':dots(10,['#6E9A44','#8FBA5A'],1.4);g.strokeStyle='#A3AE76';g.lineWidth=.8;for(let i=0;i<8;i++){const x=x0+r()*w,y=y0+r()*h;g.beginPath();g.moveTo(x,y);g.lineTo(x+(r()-.5)*2,y-3);g.stroke()}break;
